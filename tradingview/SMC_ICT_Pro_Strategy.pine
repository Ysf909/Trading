//@version=6
strategy("SMC ICT Pro - Strategy", shorttitle = "SMC ICT Pro S", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 1000, initial_capital = 10000, commission_type = strategy.commission.percent, commission_value = 0.02, slippage = 0, pyramiding = 0, process_orders_on_close = false)

// =====================================================================================
// STRATEGY build (generated by build_strategy.py - edit SMC_ICT_Pro.pine instead)
// Smart Money Concepts / ICT toolkit + the entry models of the Python agent
// (smc_agent/core/engine.py). Definitions and per-bar order are identical, so the
// setups on this chart are the setups the agent trades.
//
//  - Market structure: internal + swing BOS / CHoCH, HH/HL/LH/LL
//  - PD arrays: order blocks (swing + internal), fair value gaps
//  - Liquidity: swing highs/lows, equal highs/lows, previous-day and Asia/London
//    session highs/lows, sweeps
//  - Killzones, premium / discount, higher-timeframe bias
//  - Setups: Reversal (liquidity sweep -> MSS -> FVG/OB limit) and Continuation
//    (BOS with swing trend -> FVG/OB limit), confluence score 0-10, entry/SL/TP,
//    trade tracking with live stats, alerts and JSON webhook for the agent.
// =====================================================================================

// ------------------------------------------------------------------ inputs
const string G_STR = "Market structure"
swingLen     = input.int(20, "Swing length", minval = 2, group = G_STR, tooltip = "Pivot strength (bars each side) for swing structure, swing order blocks and the premium/discount range.")
intLen       = input.int(5, "Internal length", minval = 1, group = G_STR, tooltip = "Pivot strength for internal structure. Internal breaks are the market structure shifts used by the entry models.")
showSwingStr = input.bool(true, "Swing BOS/CHoCH", group = G_STR, inline = "st")
showIntStr   = input.bool(true, "Internal BOS/CHoCH", group = G_STR, inline = "st")
showSwingPts = input.bool(true, "HH / HL / LH / LL", group = G_STR)
atrLen       = input.int(14, "ATR length", minval = 1, group = G_STR)

const string G_PDA = "Order blocks & fair value gaps"
showOB       = input.bool(true, "Order blocks", group = G_PDA, inline = "ob")
showIntOB    = input.bool(false, "incl. internal OBs", group = G_PDA, inline = "ob")
showFVG      = input.bool(true, "Fair value gaps", group = G_PDA)
keepHistory  = input.bool(false, "Keep mitigated zones on chart", group = G_PDA)
fvgMinAtr    = input.float(0.1, "Min FVG size (x ATR)", minval = 0.0, step = 0.05, group = G_PDA)
maxZones     = input.int(20, "Max zones per type & side", minval = 1, maxval = 50, group = G_PDA)
obMaxAge     = input.int(500, "Order block max age (bars)", minval = 10, group = G_PDA)
fvgMaxAge    = input.int(300, "FVG max age (bars)", minval = 10, group = G_PDA)
obLookback   = input.int(300, "OB search lookback (bars)", minval = 10, maxval = 900, group = G_PDA)
cBullOB      = input.color(color.new(#2962FF, 80), "Bull OB", group = G_PDA, inline = "c1")
cBearOB      = input.color(color.new(#FF6D00, 80), "Bear OB", group = G_PDA, inline = "c1")
cBullFVG     = input.color(color.new(#00C853, 82), "Bull FVG", group = G_PDA, inline = "c2")
cBearFVG     = input.color(color.new(#D50000, 84), "Bear FVG", group = G_PDA, inline = "c2")

const string G_LIQ = "Liquidity"
showLiq      = input.bool(true, "Major liquidity levels", group = G_LIQ, tooltip = "Swing highs/lows (BSL/SSL), equal highs/lows, previous-day and Asia/London session highs/lows. Dotted once swept.")
showSweeps   = input.bool(true, "Mark sweeps", group = G_LIQ)
eqTol        = input.float(0.1, "Equal highs/lows tolerance (x ATR)", minval = 0.0, step = 0.05, group = G_LIQ)
maxLevels    = input.int(40, "Tracked levels per side", minval = 5, maxval = 100, group = G_LIQ)
cLiq         = input.color(#9C27B0, "Liquidity", group = G_LIQ)

const string G_KZ = "Killzones (New York time)"
showKZ       = input.bool(true, "Highlight killzones (<= 1H charts)", group = G_KZ)
kzAsia       = input.session("2000-0000", "Asia", group = G_KZ, inline = "k1")
useAsia      = input.bool(false, "scores", group = G_KZ, inline = "k1")
kzLondon     = input.session("0200-0500", "London", group = G_KZ, inline = "k2")
useLondon    = input.bool(true, "scores", group = G_KZ, inline = "k2")
kzNYAM       = input.session("0700-1000", "New York AM", group = G_KZ, inline = "k3")
useNYAM      = input.bool(true, "scores", group = G_KZ, inline = "k3")
kzLC         = input.session("1000-1200", "London close", group = G_KZ, inline = "k4")
useLC        = input.bool(false, "scores", group = G_KZ, inline = "k4")
kzNYPM       = input.session("1330-1600", "New York PM", group = G_KZ, inline = "k5")
useNYPM      = input.bool(true, "scores", group = G_KZ, inline = "k5")

const string G_HTF = "Higher-timeframe bias"
htfInput     = input.timeframe("", "Bias timeframe (empty = auto)", group = G_HTF, tooltip = "Auto: 1m -> 15m, 5m -> 1H, 15m/1H -> 4H, 4H -> D, D -> W. Uses completed HTF candles only (no repaint).")
htfLen       = input.int(5, "Bias pivot length", minval = 1, group = G_HTF)

const string G_PD = "Premium / discount"
showPD       = input.bool(true, "Premium / discount of the swing range", group = G_PD)

const string G_SET = "Setups (agent entry models)"
useRev       = input.bool(true, "Reversal: sweep -> MSS -> FVG/OB", group = G_SET)
useCont      = input.bool(true, "Continuation: BOS -> FVG/OB", group = G_SET)
mssWindow    = input.int(20, "Bars from sweep to MSS", minval = 1, group = G_SET)
fvgWait      = input.int(3, "Bars to wait for an FVG after MSS", minval = 0, group = G_SET)
useObEntry   = input.bool(true, "Fall back to the MSS order block", group = G_SET)
entryMode    = input.string("CE (50%)", "Entry", options = ["CE (50%)", "Proximal edge"], group = G_SET)
entryExpiry  = input.int(20, "Limit order valid (bars)", minval = 1, group = G_SET)
slBufAtr     = input.float(0.1, "Stop buffer (x ATR)", minval = 0.0, step = 0.05, group = G_SET)
minRiskAtr   = input.float(0.25, "Min stop distance (x ATR)", minval = 0.0, step = 0.05, group = G_SET)
maxRiskAtr   = input.float(4.0, "Max stop distance (x ATR)", minval = 0.1, step = 0.25, group = G_SET)
tpMode       = input.string("Liquidity", "Target", options = ["Liquidity", "Fixed RR"], group = G_SET, tooltip = "Liquidity: nearest opposing liquidity pool giving at least Min RR (up to Max RR), else Fixed RR.")
rrTarget     = input.float(2.0, "Fixed RR / fallback", minval = 0.5, step = 0.25, group = G_SET)
minRR        = input.float(1.5, "Min RR", minval = 0.5, step = 0.25, group = G_SET)
maxRR        = input.float(6.0, "Max RR for liquidity target", minval = 1.0, step = 0.5, group = G_SET)
beAtR        = input.float(0.0, "Stop to entry at +R (0 = off)", minval = 0.0, step = 0.25, group = G_SET)
dispAtr      = input.float(1.0, "Displacement body (x ATR)", minval = 0.1, step = 0.1, group = G_SET)
htfFilter    = input.bool(false, "Only trade with HTF bias", group = G_SET)
kzFilter     = input.bool(false, "Only trade inside scoring killzones", group = G_SET)
minScore     = input.int(6, "Min confluence score (0-10)", minval = 0, maxval = 10, group = G_SET, tooltip = "HTF bias 2, premium/discount 2, major liquidity swept 1, OB+FVG overlap 1, killzone 1, displacement 1, swing trend 1, RR >= 3 1. 6+ = grade A.")
showTrades   = input.bool(true, "Draw entry / stop / target", group = G_SET)
showDash     = input.bool(true, "Dashboard", group = G_SET, inline = "db")
riskPct      = input.float(0.5, "Risk per trade (% of equity)", minval = 0.01, step = 0.05, group = G_SET, tooltip = "Position size = equity x risk% / stop distance.")
dashPos      = input.string("Top right", "", options = ["Top right", "Bottom right", "Top left", "Bottom left"], group = G_SET, inline = "db")

const string G_AL = "Alerts / agent webhook"
passphrase   = input.string("change-me", "Webhook passphrase", group = G_AL, tooltip = "Must equal WEBHOOK_PASSPHRASE of `smc-agent webhook`. Letters and digits only.")
alertJson    = input.bool(true, "Send setups as JSON with alert()", group = G_AL, tooltip = "Create an alert with condition 'Any alert() function call' and your webhook URL.")

const color C_BULL = #089981
const color C_BEAR = #F23645

// ------------------------------------------------------------------ types
type Pivot
    float  price
    int    bar
    string tag     = ""
    bool   crossed = false

type Structure
    Pivot hi
    Pivot lo
    Pivot prevHi
    Pivot prevLo
    int   trend = 0
    float trailTop
    float trailBot
    int   trailTopBar
    int   trailBotBar

type Zone
    string kind
    int    dir
    float  top
    float  bottom
    int    left
    int    created
    string level   = ""
    bool   touched = false
    bool   alive   = true
    box    bx

type Level
    float  price
    int    side
    string kind
    int    bar
    bool   major = false
    line   ln
    label  lb

type Rev
    int    stage = 0
    float  ext
    int    extBar
    bool   major = false
    string kinds = ""
    int    mssBar
    string mssKind = ""
    float  mssPrice
    Zone   mssOb

type Trade
    int    dir
    string model
    float  entry
    float  sl
    float  slCur
    float  tp
    float  risk
    int    sigBar
    int    status  = 0
    int    fillBar
    float  fillPrice
    bool   beMoved = false
    line   lE
    line   lS
    line   lT
    box    bT
    box    bS

type Stats
    int   trades = 0
    int   wins   = 0
    int   losses = 0
    float sumR   = 0.0
    float grossW = 0.0
    float grossL = 0.0

// ------------------------------------------------------------------ helpers
f_px(float x) =>
    str.tostring(x, format.mintick)

f_num(float x) =>
    str.tostring(math.round_to_mintick(x), "#.##########")

f_grade(int score) =>
    score >= 8 ? "A+" : score >= 6 ? "A" : score >= 4 ? "B" : "C"

f_trendTxt(int t) =>
    t == 1 ? "Bullish" : t == -1 ? "Bearish" : "-"

f_autoHTF() =>
    int sec = timeframe.in_seconds()
    sec <= 60 ? "15" : sec <= 300 ? "60" : sec <= 3600 ? "240" : sec <= 14400 ? "D" : "W"

f_inSess(string sess) =>
    not na(time(timeframe.period, sess + ":1234567", "America/New_York"))

// pivot high at bar n bars ago: higher than the n bars before it, >= the n bars after it
f_pivots(int n) =>
    float leftHi  = ta.highest(high, n)[n + 1]
    float rightHi = ta.highest(high, n)
    float leftLo  = ta.lowest(low, n)[n + 1]
    float rightLo = ta.lowest(low, n)
    float ph = na
    float pl = na
    if bar_index >= 2 * n
        if high[n] > leftHi and high[n] >= rightHi
            ph := high[n]
        if low[n] < leftLo and low[n] <= rightLo
            pl := low[n]
    [ph, pl]

// trend of a pivot structure (used inside request.security for the HTF bias)
f_htfTrend(int n) =>
    var int   trend = 0
    var float hiP   = na
    var bool  hiX   = true
    var float loP   = na
    var bool  loX   = true
    [ph, pl] = f_pivots(n)
    if not na(ph)
        hiP := ph
        hiX := false
    if not na(pl)
        loP := pl
        loX := false
    if not hiX and close > hiP
        hiX   := true
        trend := 1
    if not loX and close < loP
        loX   := true
        trend := -1
    trend

method advance(Structure s, float ph, float pl, int n) =>
    if not na(ph)
        string tag = "H"
        if not na(s.hi)
            tag := ph > s.hi.price ? "HH" : "LH"
        s.prevHi      := s.hi
        s.hi          := Pivot.new(ph, bar_index - n, tag, false)
        s.trailTop    := ph
        s.trailTopBar := bar_index - n
    if not na(pl)
        string tag = "L"
        if not na(s.lo)
            tag := pl > s.lo.price ? "HL" : "LL"
        s.prevLo      := s.lo
        s.lo          := Pivot.new(pl, bar_index - n, tag, false)
        s.trailBot    := pl
        s.trailBotBar := bar_index - n
    if not na(s.trailTop)
        if high > s.trailTop
            s.trailTop    := high
            s.trailTopBar := bar_index
    if not na(s.trailBot)
        if low < s.trailBot
            s.trailBot    := low
            s.trailBotBar := bar_index
    bool   bull      = false
    string bullKind  = ""
    float  bullPrice = na
    int    bullPivot = na
    bool   bear      = false
    string bearKind  = ""
    float  bearPrice = na
    int    bearPivot = na
    if not na(s.hi)
        Pivot h = s.hi
        if not h.crossed and close > h.price
            bullKind  := s.trend == -1 ? "CHoCH" : "BOS"
            h.crossed := true
            s.trend   := 1
            bull      := true
            bullPrice := h.price
            bullPivot := h.bar
    if not na(s.lo)
        Pivot l = s.lo
        if not l.crossed and close < l.price
            bearKind  := s.trend == 1 ? "CHoCH" : "BOS"
            l.crossed := true
            s.trend   := -1
            bear      := true
            bearPrice := l.price
            bearPivot := l.bar
    [bull, bullKind, bullPrice, bullPivot, bear, bearKind, bearPrice, bearPivot]

f_kindName(string k, int side) =>
    switch k
        "internal"    => side == 1 ? "iBSL" : "iSSL"
        "swing"       => side == 1 ? "BSL" : "SSL"
        "eqh"         => "EQH"
        "eql"         => "EQL"
        "pdh"         => "PDH"
        "pdl"         => "PDL"
        "asia_high"   => "Asia H"
        "asia_low"    => "Asia L"
        "london_high" => "London H"
        "london_low"  => "London L"
        => k

// ------------------------------------------------------------------ liquidity levels
f_drawLevel(Level lv) =>
    if showLiq and lv.major and na(lv.ln)
        lv.ln := line.new(lv.bar, lv.price, bar_index, lv.price, color = cLiq, style = line.style_dashed, width = 1, extend = extend.right)
        lv.lb := label.new(bar_index, lv.price, f_kindName(lv.kind, lv.side), style = label.style_label_left, color = color(na), textcolor = cLiq, size = size.tiny)

f_endLevel(Level lv, bool swept) =>
    if not na(lv.ln)
        line.set_extend(lv.ln, extend.none)
        line.set_x2(lv.ln, bar_index)
        if swept
            line.set_style(lv.ln, line.style_dotted)
    if not na(lv.lb)
        label.set_x(lv.lb, bar_index)

f_addLevel(array<Level> levels, float price, int side, string kind, int bar, bool major) =>
    bool found = false
    int sz = levels.size()
    if sz > 0
        for i = 0 to sz - 1
            Level lv = levels.get(i)
            if lv.side == side and lv.price == price
                found := true
                if major and not lv.major
                    lv.major := true
                    lv.kind  := kind
                    f_drawLevel(lv)
                break
    if not found
        Level nl = Level.new(price, side, kind, bar, major)
        levels.push(nl)
        f_drawLevel(nl)
        int cnt       = 0
        int oldestIdx = -1
        int oldestBar = na
        for i = 0 to levels.size() - 1
            Level lv = levels.get(i)
            if lv.side == side
                cnt += 1
                if na(oldestBar) or lv.bar < oldestBar
                    oldestBar := lv.bar
                    oldestIdx := i
        if cnt > maxLevels and oldestIdx >= 0
            Level old = levels.remove(oldestIdx)
            if not na(old.ln)
                line.delete(old.ln)
            if not na(old.lb)
                label.delete(old.lb)
    found

f_replaceLevel(array<Level> levels, string kind, float price, int side, int bar) =>
    if levels.size() > 0
        for i = levels.size() - 1 to 0
            Level lv = levels.get(i)
            if lv.kind == kind
                f_endLevel(lv, false)
                levels.remove(i)
    f_addLevel(levels, price, side, kind, bar, true)

f_sweep(array<Level> levels) =>
    bool   sslTaken = false
    bool   sslMajor = false
    string sslKinds = ""
    bool   bslTaken = false
    bool   bslMajor = false
    string bslKinds = ""
    if levels.size() > 0
        for i = levels.size() - 1 to 0
            Level lv = levels.get(i)
            bool hit = (lv.side == 1 and high > lv.price) or (lv.side == -1 and low < lv.price)
            if hit
                if lv.side == -1
                    sslTaken := true
                    sslMajor := sslMajor or lv.major
                    sslKinds := sslKinds == "" ? lv.kind : sslKinds + "," + lv.kind
                else
                    bslTaken := true
                    bslMajor := bslMajor or lv.major
                    bslKinds := bslKinds == "" ? lv.kind : bslKinds + "," + lv.kind
                f_endLevel(lv, true)
                if showSweeps and lv.major
                    bool rejected = lv.side == 1 ? close < lv.price : close > lv.price
                    string what = (lv.side == 1 ? "Buy-side" : "Sell-side") + " liquidity (" + f_kindName(lv.kind, lv.side) + ") " + (rejected ? "swept and rejected" : "taken")
                    label.new(bar_index, lv.price, "", style = label.style_xcross, color = cLiq, size = size.tiny, tooltip = what)
                levels.remove(i)
    [sslTaken, sslMajor, sslKinds, bslTaken, bslMajor, bslKinds]

// ------------------------------------------------------------------ zones
f_zoneColor(Zone z) =>
    z.kind == "OB" ? (z.dir == 1 ? cBullOB : cBearOB) : (z.dir == 1 ? cBullFVG : cBearFVG)

f_drawZone(Zone z) =>
    bool show = z.kind == "FVG" ? showFVG : (showOB and (z.level == "swing" or showIntOB))
    if show and na(z.bx)
        color c = f_zoneColor(z)
        string txt = z.kind == "OB" ? (z.level == "swing" ? "OB" : "iOB") : "FVG"
        z.bx := box.new(z.left, z.top, bar_index, z.bottom, border_color = color.new(c, 55), bgcolor = c, extend = extend.right, text = txt, text_size = size.tiny, text_color = color.new(color.gray, 20), text_halign = text.align_right, text_valign = text.align_center)

f_killZone(Zone z) =>
    z.alive := false
    if not na(z.bx)
        if keepHistory
            box.set_extend(z.bx, extend.none)
            box.set_right(z.bx, bar_index)
        else
            box.delete(z.bx)

f_pushZone(array<Zone> zs, Zone z) =>
    zs.push(z)
    f_drawZone(z)
    int cnt = 0
    for i = 0 to zs.size() - 1
        if zs.get(i).dir == z.dir
            cnt += 1
    if cnt > maxZones
        for i = 0 to zs.size() - 1
            Zone o = zs.get(i)
            if o.dir == z.dir
                f_killZone(o)
                zs.remove(i)
                break

f_makeOB(array<Zone> obs, int dir, int pivotBar, string level) =>
    int lo    = math.max(pivotBar, bar_index - obLookback, 0)
    int span  = bar_index - lo
    int bestJ = 0
    float best = dir == 1 ? low : high
    if span > 0
        for j = 1 to span
            if dir == 1
                if low[j] < best
                    best  := low[j]
                    bestJ := j
            else
                if high[j] > best
                    best  := high[j]
                    bestJ := j
    int bestBar = bar_index - bestJ
    Zone found = na
    if obs.size() > 0
        for i = 0 to obs.size() - 1
            Zone z = obs.get(i)
            if z.dir == dir and z.left == bestBar
                found := z
                break
    if not na(found)
        if level == "swing" and found.level != "swing"
            found.level := "swing"
            f_drawZone(found)
    else
        found := Zone.new("OB", dir, high[bestJ], low[bestJ], bestBar, bar_index, level)
        f_pushZone(obs, found)
    found

f_maintain(array<Zone> zs, int maxAge) =>
    if zs.size() > 0
        for i = zs.size() - 1 to 0
            Zone z = zs.get(i)
            if z.created != bar_index
                bool dead = false
                if z.dir == 1
                    if low <= z.top
                        z.touched := true
                    dead := z.kind == "FVG" ? low <= z.bottom : close < z.bottom
                else
                    if high >= z.bottom
                        z.touched := true
                    dead := z.kind == "FVG" ? high >= z.top : close > z.top
                if dead or bar_index - z.created > maxAge
                    f_killZone(z)
                    zs.remove(i)

f_latestFvg(array<Zone> fvgs, int d, int since) =>
    Zone res = na
    if fvgs.size() > 0
        for i = fvgs.size() - 1 to 0
            Zone z = fvgs.get(i)
            if z.dir == d and z.created >= since and z.alive
                res := z
                break
    res

f_overlapAny(array<Zone> zs, int d, float top, float bottom) =>
    bool res = false
    if zs.size() > 0
        for i = 0 to zs.size() - 1
            Zone z = zs.get(i)
            if z.dir == d and z.bottom <= top and bottom <= z.top
                res := true
                break
    res

f_drawBreak(int pivotBar, float price, int d, string kind, bool internal) =>
    color c = d == 1 ? C_BULL : C_BEAR
    line.new(pivotBar, price, bar_index, price, color = c, style = internal ? line.style_dashed : line.style_solid, width = 1)
    label.new(math.round((pivotBar + bar_index) / 2), price, internal ? "i" + kind : kind, style = d == 1 ? label.style_label_down : label.style_label_up, color = color(na), textcolor = c, size = size.tiny)

// ------------------------------------------------------------------ entry models
f_reversal(Rev st, int d, bool taken, bool takenMajor, string takenKinds, bool brk, string brkKind, float brkPrice, Zone newOb, array<Zone> fvgs) =>
    float extNow = d == 1 ? low : high
    bool beyond = false
    if st.stage > 0
        beyond := d == 1 ? extNow < st.ext : extNow > st.ext
    if taken
        if st.stage == 0
            st.stage  := 1
            st.ext    := extNow
            st.extBar := bar_index
            st.major  := takenMajor
            st.kinds  := takenKinds
        else if beyond
            st.stage  := 1
            st.ext    := extNow
            st.extBar := bar_index
            st.major  := st.major or takenMajor
            st.kinds  := st.kinds + "," + takenKinds
        else if st.stage == 1
            st.major  := st.major or takenMajor
            st.kinds  := st.kinds + "," + takenKinds
    else if beyond
        st.stage  := 1
        st.ext    := extNow
        st.extBar := bar_index
    if st.stage == 1 and bar_index - st.extBar > mssWindow
        st.stage := 0
    if st.stage == 1 and brk
        st.stage    := 2
        st.mssBar   := bar_index
        st.mssKind  := brkKind
        st.mssPrice := brkPrice
        st.mssOb    := newOb
    Zone zone = na
    if st.stage == 2
        zone := f_latestFvg(fvgs, d, st.extBar + 2)
        if na(zone)
            if bar_index - st.mssBar >= fvgWait
                if useObEntry and not na(st.mssOb)
                    if st.mssOb.alive
                        zone := st.mssOb
                if na(zone)
                    st.stage := 0
        if not na(zone)
            st.stage := 0
    zone

f_cont(int d, bool brk, string brkKind, int swingTrend, Pivot anchor, Zone newOb, array<Zone> fvgs) =>
    Zone zone = na
    if brk and brkKind == "BOS" and swingTrend == d and not na(anchor)
        zone := f_latestFvg(fvgs, d, anchor.bar + 2)
        if na(zone) and useObEntry and not na(newOb)
            if newOb.alive
                zone := newOb
    zone

// entry / target / confluence score for a candidate zone
f_build(int d, Zone zone, float sl, bool majorSweep, array<Level> levels, array<Zone> obs, array<Zone> fvgs, int htf, int swingTrend, float eq, bool inKz, float atrV) =>
    bool   ok      = false
    float  entry   = na
    float  tp      = na
    float  rr      = na
    float  riskAtr = na
    int    score   = 0
    string tpKind  = ""
    bool   pdOk    = false
    bool   confl   = false
    bool   disp    = false
    if not na(zone) and not na(sl) and atrV > 0
        entry := entryMode == "CE (50%)" ? (zone.top + zone.bottom) / 2 : (d == 1 ? zone.top : zone.bottom)
        float risk = (entry - sl) * d
        if risk > 0
            riskAtr := risk / atrV
            if riskAtr >= minRiskAtr and riskAtr <= maxRiskAtr
                float bestDist  = na
                float bestPrice = na
                string bestKind = ""
                if tpMode == "Liquidity" and levels.size() > 0
                    for i = 0 to levels.size() - 1
                        Level lv = levels.get(i)
                        float dist = (lv.price - entry) * d
                        if lv.side == d and dist > 0 and dist / risk >= minRR
                            if na(bestDist) or dist < bestDist
                                bestDist  := dist
                                bestPrice := lv.price
                                bestKind  := lv.kind
                if not na(bestDist) and bestDist / risk <= maxRR
                    tp     := bestPrice
                    tpKind := f_kindName(bestKind, d)
                else
                    tp     := entry + d * rrTarget * risk
                    tpKind := str.tostring(rrTarget) + "R"
                rr := (tp - entry) * d / risk
                if rr >= minRR - 1e-9
                    pdOk := not na(eq) and (d == 1 ? entry < eq : entry > eq)
                    float body = 0.0
                    if zone.kind == "FVG"
                        int off = bar_index - zone.left
                        body  := math.abs(close[off] - open[off])
                        confl := f_overlapAny(obs, d, zone.top, zone.bottom)
                    else
                        int span = bar_index - zone.left
                        for j = 0 to span
                            body := math.max(body, math.abs(close[j] - open[j]))
                        confl := f_overlapAny(fvgs, d, zone.top, zone.bottom)
                    disp  := body >= dispAtr * atrV
                    score := (htf == d ? 2 : 0) + (pdOk ? 2 : 0) + (majorSweep ? 1 : 0) + (confl ? 1 : 0) + (inKz ? 1 : 0) + (disp ? 1 : 0) + (swingTrend == d ? 1 : 0) + (rr >= 3.0 ? 1 : 0)
                    ok := true
                    if htfFilter and htf != d
                        ok := false
                    if kzFilter and not inKz
                        ok := false
                    if score < minScore
                        ok := false
    [ok, entry, tp, rr, riskAtr, score, tpKind, pdOk, confl, disp]

// ===================================================================== per-bar engine
// 0) manage the tracked trade with this bar (orders were placed on earlier bars)
var Trade cur   = na
var Stats stats = Stats.new()
bool   evFill     = false
bool   evExit     = false
bool   evCancel   = false
int    evDir      = 0
float  exitPrice  = na
float  exitR      = na
string exitReason = ""
if not na(cur)
    int d = cur.dir
    evDir := d
    if cur.status == 0
        if bar_index - cur.sigBar > entryExpiry
            evCancel   := true
            exitReason := "expired"
        else
            bool gap   = d == 1 ? open <= cur.entry : open >= cur.entry
            bool touch = d == 1 ? low <= cur.entry : high >= cur.entry
            if gap or touch
                cur.status    := 1
                cur.fillPrice := gap ? open : cur.entry
                cur.fillBar   := bar_index
                evFill        := true
                bool stopped = d == 1 ? low <= cur.slCur : high >= cur.slCur
                if stopped
                    bool gapStop = d == 1 ? open <= cur.slCur : open >= cur.slCur
                    exitPrice  := gapStop ? open : cur.slCur
                    exitReason := "sl"
                    evExit     := true
            else if (d == 1 ? high >= cur.tp : low <= cur.tp)
                evCancel   := true
                exitReason := "missed"
    else
        float xp = na
        string xr = ""
        if d == 1
            if open <= cur.slCur
                xp := open
                xr := cur.beMoved ? "be" : "sl"
            else if low <= cur.slCur
                xp := cur.slCur
                xr := cur.beMoved ? "be" : "sl"
            else if open >= cur.tp
                xp := open
                xr := "tp"
            else if high >= cur.tp
                xp := cur.tp
                xr := "tp"
        else
            if open >= cur.slCur
                xp := open
                xr := cur.beMoved ? "be" : "sl"
            else if high >= cur.slCur
                xp := cur.slCur
                xr := cur.beMoved ? "be" : "sl"
            else if open <= cur.tp
                xp := open
                xr := "tp"
            else if low <= cur.tp
                xp := cur.tp
                xr := "tp"
        if not na(xp)
            exitPrice  := xp
            exitReason := xr
            evExit     := true
        else if beAtR > 0 and not cur.beMoved
            float trig = cur.entry + d * beAtR * cur.risk
            if (d == 1 ? high >= trig : low <= trig)
                cur.slCur   := cur.fillPrice
                cur.beMoved := true
                strategy.exit("SMC exit", from_entry = "SMC", stop = cur.slCur, limit = cur.tp)

// trade drawings / stats
if not na(cur) and evFill and showTrades
    line.delete(cur.lE)
    line.delete(cur.lS)
    line.delete(cur.lT)
    cur.bT := box.new(bar_index, cur.tp, bar_index + 1, cur.entry, border_color = color.new(C_BULL, 60), bgcolor = color.new(C_BULL, 85))
    cur.bS := box.new(bar_index, cur.entry, bar_index + 1, cur.sl, border_color = color.new(C_BEAR, 60), bgcolor = color.new(C_BEAR, 85))
if not na(cur) and not evExit and not evFill and showTrades
    if cur.status == 1
        box.set_right(cur.bT, bar_index + 1)
        box.set_right(cur.bS, bar_index + 1)
if not na(cur) and evExit
    exitR := (exitPrice - cur.fillPrice) * cur.dir / cur.risk
    stats.trades += 1
    stats.sumR   += exitR
    if exitR > 1e-9
        stats.wins   += 1
        stats.grossW += exitR
    else if exitR < -1e-9
        stats.losses += 1
        stats.grossL -= exitR
    if showTrades
        box.set_right(cur.bT, bar_index)
        box.set_right(cur.bS, bar_index)
        label.new(bar_index, exitPrice, (exitR >= 0 ? "+" : "") + str.tostring(exitR, "#.##") + "R", style = label.style_label_left, color = color(na), textcolor = exitR > 0 ? C_BULL : exitR < 0 ? C_BEAR : color.gray, size = size.small, tooltip = cur.model + " " + exitReason)
    cur := na
if not na(cur) and evCancel
    strategy.cancel("SMC")
    if showTrades
        for ln in array.from(cur.lE, cur.lS, cur.lT)
            line.set_x2(ln, bar_index)
            line.set_color(ln, color.new(color.gray, 50))
    cur := na

// 1) volatility, higher-timeframe bias, killzones
float  atr      = ta.atr(atrLen)
string htfTF    = htfInput == "" ? f_autoHTF() : htfInput
int    htfTrend = nz(request.security(syminfo.tickerid, htfTF, f_htfTrend(htfLen)[1], lookahead = barmerge.lookahead_on))
bool inAsia   = f_inSess(kzAsia)
bool inLondon = f_inSess(kzLondon)
bool inNYAM   = f_inSess(kzNYAM)
bool inLC     = f_inSess(kzLC)
bool inNYPM   = f_inSess(kzNYPM)
bool inKzScore = (useAsia and inAsia) or (useLondon and inLondon) or (useNYAM and inNYAM) or (useLC and inLC) or (useNYPM and inNYPM)

// 2) session ranges and previous day -> liquidity
var array<Level> levels = array.new<Level>()
var float asH = na
var float asL = na
var bool  asAct = false
var int   asStart = na
if inAsia
    if not asAct
        asAct   := true
        asH     := high
        asL     := low
        asStart := bar_index
    else
        asH := math.max(asH, high)
        asL := math.min(asL, low)
else if asAct
    asAct := false
    f_replaceLevel(levels, "asia_high", asH, 1, asStart)
    f_replaceLevel(levels, "asia_low", asL, -1, asStart)

var float loH = na
var float loL = na
var bool  loAct = false
var int   loStart = na
if inLondon
    if not loAct
        loAct   := true
        loH     := high
        loL     := low
        loStart := bar_index
    else
        loH := math.max(loH, high)
        loL := math.min(loL, low)
else if loAct
    loAct := false
    f_replaceLevel(levels, "london_high", loH, 1, loStart)
    f_replaceLevel(levels, "london_low", loL, -1, loStart)

var float dH = na
var float dL = na
var int   dStart = na
if timeframe.change("D") or na(dH)
    if not na(dH)
        f_replaceLevel(levels, "pdh", dH, 1, dStart)
        f_replaceLevel(levels, "pdl", dL, -1, dStart)
    dH     := high
    dL     := low
    dStart := bar_index
else
    dH := math.max(dH, high)
    dL := math.min(dL, low)

// 3) market structure
var Structure intS = Structure.new()
var Structure swgS = Structure.new()
[iPH, iPL] = f_pivots(intLen)
[sPH, sPL] = f_pivots(swingLen)
[iBull, iBullKind, iBullPrice, iBullPivot, iBear, iBearKind, iBearPrice, iBearPivot] = intS.advance(iPH, iPL, intLen)
[sBull, sBullKind, sBullPrice, sBullPivot, sBear, sBearKind, sBearPrice, sBearPivot] = swgS.advance(sPH, sPL, swingLen)

// 4) pivots -> liquidity, equal highs / lows
float eqTolPx = na(atr) ? 0.0 : atr * eqTol
if not na(iPH)
    f_addLevel(levels, iPH, 1, "internal", bar_index - intLen, false)
    if not na(intS.prevHi) and eqTolPx > 0
        if math.abs(iPH - intS.prevHi.price) <= eqTolPx
            float eqp = math.max(iPH, intS.prevHi.price)
            f_addLevel(levels, eqp, 1, "eqh", bar_index - intLen, true)
            if showLiq
                line.new(intS.prevHi.bar, eqp, bar_index - intLen, eqp, color = cLiq, style = line.style_dotted)
                label.new(bar_index - intLen, eqp, "EQH", style = label.style_label_down, color = color(na), textcolor = cLiq, size = size.tiny)
if not na(iPL)
    f_addLevel(levels, iPL, -1, "internal", bar_index - intLen, false)
    if not na(intS.prevLo) and eqTolPx > 0
        if math.abs(iPL - intS.prevLo.price) <= eqTolPx
            float eqp = math.min(iPL, intS.prevLo.price)
            f_addLevel(levels, eqp, -1, "eql", bar_index - intLen, true)
            if showLiq
                line.new(intS.prevLo.bar, eqp, bar_index - intLen, eqp, color = cLiq, style = line.style_dotted)
                label.new(bar_index - intLen, eqp, "EQL", style = label.style_label_up, color = color(na), textcolor = cLiq, size = size.tiny)
if not na(sPH)
    f_addLevel(levels, sPH, 1, "swing", bar_index - swingLen, true)
    if showSwingPts
        label.new(bar_index - swingLen, sPH, swgS.hi.tag, style = label.style_label_down, color = color(na), textcolor = color.new(color.gray, 10), size = size.tiny)
if not na(sPL)
    f_addLevel(levels, sPL, -1, "swing", bar_index - swingLen, true)
    if showSwingPts
        label.new(bar_index - swingLen, sPL, swgS.lo.tag, style = label.style_label_up, color = color(na), textcolor = color.new(color.gray, 10), size = size.tiny)

// 5) liquidity sweeps
[sslTaken, sslMajor, sslKinds, bslTaken, bslMajor, bslKinds] = f_sweep(levels)

// 6) order blocks from every break (internal first, bullish first)
var array<Zone> obs = array.new<Zone>()
Zone iBullOb = na
Zone iBearOb = na
if iBull
    iBullOb := f_makeOB(obs, 1, iBullPivot, "internal")
if iBear
    iBearOb := f_makeOB(obs, -1, iBearPivot, "internal")
if sBull
    f_makeOB(obs, 1, sBullPivot, "swing")
if sBear
    f_makeOB(obs, -1, sBearPivot, "swing")
if iBull and showIntStr
    f_drawBreak(iBullPivot, iBullPrice, 1, iBullKind, true)
if iBear and showIntStr
    f_drawBreak(iBearPivot, iBearPrice, -1, iBearKind, true)
if sBull and showSwingStr
    f_drawBreak(sBullPivot, sBullPrice, 1, sBullKind, false)
if sBear and showSwingStr
    f_drawBreak(sBearPivot, sBearPrice, -1, sBearKind, false)

// 7) fair value gaps
var array<Zone> fvgs = array.new<Zone>()
if not na(atr) and bar_index >= 2
    float minGap = fvgMinAtr * atr
    if low > high[2] and close[1] > high[2] and (low - high[2]) >= minGap
        f_pushZone(fvgs, Zone.new("FVG", 1, low, high[2], bar_index - 1, bar_index))
    if high < low[2] and close[1] < low[2] and (low[2] - high) >= minGap
        f_pushZone(fvgs, Zone.new("FVG", -1, low[2], high, bar_index - 1, bar_index))

// 8) zone touches / invalidation
f_maintain(obs, obMaxAge)
f_maintain(fvgs, fvgMaxAge)

// 9) entry models
var Rev revL = Rev.new()
var Rev revS = Rev.new()
float eq    = na(swgS.trailTop) or na(swgS.trailBot) ? na : (swgS.trailTop + swgS.trailBot) / 2
bool  ready = not na(atr) and bar_index >= 2 * math.max(swingLen, intLen)

Zone  zLr  = na
float slLr = na
Zone  zSr  = na
float slSr = na
if ready and useRev
    zLr := f_reversal(revL, 1, sslTaken, sslMajor, sslKinds, iBull, iBullKind, iBullPrice, iBullOb, fvgs)
    if not na(zLr)
        slLr := revL.ext - slBufAtr * atr
    zSr := f_reversal(revS, -1, bslTaken, bslMajor, bslKinds, iBear, iBearKind, iBearPrice, iBearOb, fvgs)
    if not na(zSr)
        slSr := revS.ext + slBufAtr * atr
[okLr, eLr, tpLr, rrLr, raLr, scLr, tkLr, pdLr, cfLr, dsLr] = f_build(1, zLr, slLr, revL.major, levels, obs, fvgs, htfTrend, swgS.trend, eq, inKzScore, atr)
[okSr, eSr, tpSr, rrSr, raSr, scSr, tkSr, pdSr, cfSr, dsSr] = f_build(-1, zSr, slSr, revS.major, levels, obs, fvgs, htfTrend, swgS.trend, eq, inKzScore, atr)

Zone  zLc  = na
float slLc = na
Zone  zSc  = na
float slSc = na
if ready and useCont and not okLr and iBull
    zLc := f_cont(1, iBull, iBullKind, swgS.trend, intS.lo, iBullOb, fvgs)
    if not na(zLc)
        slLc := intS.lo.price - slBufAtr * atr
if ready and useCont and not okSr and iBear
    zSc := f_cont(-1, iBear, iBearKind, swgS.trend, intS.hi, iBearOb, fvgs)
    if not na(zSc)
        slSc := intS.hi.price + slBufAtr * atr
[okLc, eLc, tpLc, rrLc, raLc, scLc, tkLc, pdLc, cfLc, dsLc] = f_build(1, zLc, slLc, false, levels, obs, fvgs, htfTrend, swgS.trend, eq, inKzScore, atr)
[okSc, eSc, tpSc, rrSc, raSc, scSc, tkSc, pdSc, cfSc, dsSc] = f_build(-1, zSc, slSc, false, levels, obs, fvgs, htfTrend, swgS.trend, eq, inKzScore, atr)

// final signal per side (reversal has priority, like the agent)
bool   armL    = okLr or okLc
bool   armS    = okSr or okSc
bool   revPickL = okLr
bool   revPickS = okSr
float  sigEL   = revPickL ? eLr : eLc
float  sigSLL  = revPickL ? slLr : slLc
float  sigTPL  = revPickL ? tpLr : tpLc
float  sigRRL  = revPickL ? rrLr : rrLc
float  sigRAL  = revPickL ? raLr : raLc
int    sigScL  = revPickL ? scLr : scLc
string sigTkL  = revPickL ? tkLr : tkLc
bool   sigPdL  = revPickL ? pdLr : pdLc
bool   sigCfL  = revPickL ? cfLr : cfLc
bool   sigDsL  = revPickL ? dsLr : dsLc
float  sigES   = revPickS ? eSr : eSc
float  sigSLS  = revPickS ? slSr : slSc
float  sigTPS  = revPickS ? tpSr : tpSc
float  sigRRS  = revPickS ? rrSr : rrSc
float  sigRAS  = revPickS ? raSr : raSc
int    sigScS  = revPickS ? scSr : scSc
string sigTkS  = revPickS ? tkSr : tkSc
bool   sigPdS  = revPickS ? pdSr : pdSc
bool   sigCfS  = revPickS ? cfSr : cfSc
bool   sigDsS  = revPickS ? dsSr : dsSc
bool sigZfL = false
if okLr
    sigZfL := zLr.kind == "FVG"
else if okLc
    sigZfL := zLc.kind == "FVG"
bool sigZfS = false
if okSr
    sigZfS := zSr.kind == "FVG"
else if okSc
    sigZfS := zSc.kind == "FVG"

f_tooltip(int d, bool isRev, Rev st, float e, float sl, float tp, float rr, int score, string tpKind, bool pdOk, bool confl, bool disp, bool zoneFvg) =>
    string t = (isRev ? "Reversal" : "Continuation") + " | score " + str.tostring(score) + "/10 (" + f_grade(score) + ")\n"
    t += "Limit " + f_px(e) + "  SL " + f_px(sl) + "  TP " + f_px(tp) + "  (" + str.tostring(rr, "#.##") + "R -> " + tpKind + ")\n"
    if isRev
        t += "Took " + (d == 1 ? "sell" : "buy") + "-side liquidity (" + st.kinds + ")" + (st.major ? " [major]" : "") + "\n"
        t += "MSS " + st.mssKind + " through " + f_px(st.mssPrice) + "\n"
    else
        t += "Internal BOS with the swing trend\n"
    t += "Entry: " + (zoneFvg ? "FVG" : "order block") + (confl ? " + OB/FVG overlap" : "") + "\n"
    t += "HTF " + (htfTrend == d ? "aligned" : htfTrend == -d ? "against" : "neutral") + " | " + (pdOk ? (d == 1 ? "discount" : "premium") : "wrong side of EQ") + " | " + (inKzScore ? "killzone" : "off-session") + (disp ? " | displacement" : "")
    t

if armL
    label.new(bar_index, low, "BUY " + f_grade(sigScL), style = label.style_label_up, color = C_BULL, textcolor = color.white, size = size.small, tooltip = f_tooltip(1, revPickL, revL, sigEL, sigSLL, sigTPL, sigRRL, sigScL, sigTkL, sigPdL, sigCfL, sigDsL, sigZfL))
if armS
    label.new(bar_index, high, "SELL " + f_grade(sigScS), style = label.style_label_down, color = C_BEAR, textcolor = color.white, size = size.small, tooltip = f_tooltip(-1, revPickS, revS, sigES, sigSLS, sigTPS, sigRRS, sigScS, sigTkS, sigPdS, sigCfS, sigDsS, sigZfS))

// the tracked trade: highest score wins, a fresher setup replaces a pending order,
// setups are ignored while a position is open (same as the agent's backtester)
int pick = armL and armS ? (sigScL >= sigScS ? 1 : -1) : armL ? 1 : armS ? -1 : 0
bool placed   = false
bool canPlace = na(cur)
if not na(cur)
    canPlace := cur.status == 0
if pick != 0 and canPlace
    if not na(cur)
        strategy.cancel("SMC")
        if showTrades
            for ln in array.from(cur.lE, cur.lS, cur.lT)
                line.set_x2(ln, bar_index)
                line.set_color(ln, color.new(color.gray, 50))
    float e  = pick == 1 ? sigEL : sigES
    float sl = pick == 1 ? sigSLL : sigSLS
    float tp = pick == 1 ? sigTPL : sigTPS
    string model = (pick == 1 ? revPickL : revPickS) ? "reversal" : "continuation"
    cur := Trade.new(pick, model, e, sl, sl, tp, math.abs(e - sl), bar_index)
    placed := true
    strategy.cancel("SMC")
    float qtyUnits = strategy.equity * riskPct / 100 / math.abs(e - sl)
    strategy.entry("SMC", pick == 1 ? strategy.long : strategy.short, qty = qtyUnits, limit = e)
    strategy.exit("SMC exit", from_entry = "SMC", stop = sl, limit = tp)
    if showTrades
        cur.lE := line.new(bar_index, e, bar_index + entryExpiry, e, color = color.new(color.gray, 0), style = line.style_dashed, width = 1)
        cur.lS := line.new(bar_index, sl, bar_index + entryExpiry, sl, color = color.new(C_BEAR, 20), style = line.style_dashed, width = 1)
        cur.lT := line.new(bar_index, tp, bar_index + entryExpiry, tp, color = color.new(C_BULL, 20), style = line.style_dashed, width = 1)

// ------------------------------------------------------------------ premium / discount
var box  pdPrem = na
var box  pdDisc = na
var line pdEq   = na
if showPD and barstate.islast and not na(eq)
    box.delete(pdPrem)
    box.delete(pdDisc)
    line.delete(pdEq)
    int   left = math.min(swgS.trailTopBar, swgS.trailBotBar)
    float top  = swgS.trailTop
    float bot  = swgS.trailBot
    pdPrem := box.new(left, top, bar_index + 10, 0.95 * top + 0.05 * bot, border_color = color(na), bgcolor = color.new(C_BEAR, 88), text = "Premium", text_size = size.tiny, text_color = color.new(C_BEAR, 30), text_halign = text.align_right)
    pdDisc := box.new(left, 0.05 * top + 0.95 * bot, bar_index + 10, bot, border_color = color(na), bgcolor = color.new(C_BULL, 88), text = "Discount", text_size = size.tiny, text_color = color.new(C_BULL, 30), text_halign = text.align_right)
    pdEq   := line.new(left, eq, bar_index + 10, eq, color = color.new(color.gray, 30), style = line.style_dotted)

if barstate.islast and levels.size() > 0
    for lv in levels
        if not na(lv.lb)
            label.set_x(lv.lb, bar_index + 2)

// ------------------------------------------------------------------ killzones
bool kzVisible = showKZ and timeframe.isintraday and timeframe.in_seconds() <= 3600
color kzCol = not kzVisible ? na : inLondon ? color.new(#2962FF, 93) : inNYAM ? color.new(#089981, 93) : inNYPM ? color.new(#FF9800, 94) : inLC ? color.new(#9C27B0, 95) : inAsia ? color.new(#787B86, 95) : na
bgcolor(kzCol, title = "Killzones")

// ------------------------------------------------------------------ dashboard
f_pos(string p) =>
    switch p
        "Top right"    => position.top_right
        "Bottom right" => position.bottom_right
        "Top left"     => position.top_left
        => position.bottom_left

f_row(table t, int r, string a, string b, color c) =>
    table.cell(t, 0, r, a, text_color = color.new(color.gray, 10), text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, b, text_color = c, text_size = size.small, text_halign = text.align_right)

f_setupTxt(Rev st, int d) =>
    st.stage == 2 ? "MSS confirmed" : st.stage == 1 ? (d == 1 ? "SSL taken" : "BSL taken") : "waiting"

var table dash = table.new(f_pos(dashPos), 2, 11, bgcolor = color.new(#131722, 15), frame_color = color.new(color.gray, 60), frame_width = 1, border_color = color.new(color.gray, 85), border_width = 1)
if showDash and barstate.islast
    color tc = color.new(color.white, 10)
    f_row(dash, 0, "SMC ICT Pro", "min score " + str.tostring(minScore), tc)
    f_row(dash, 1, "HTF bias (" + htfTF + ")", f_trendTxt(htfTrend), htfTrend == 1 ? C_BULL : htfTrend == -1 ? C_BEAR : tc)
    f_row(dash, 2, "Swing / internal", f_trendTxt(swgS.trend) + " / " + f_trendTxt(intS.trend), swgS.trend == 1 ? C_BULL : swgS.trend == -1 ? C_BEAR : tc)
    string zoneTxt = "-"
    if not na(eq) and swgS.trailTop > swgS.trailBot
        float pct = (close - swgS.trailBot) / (swgS.trailTop - swgS.trailBot) * 100
        zoneTxt := (close > eq ? "Premium " : "Discount ") + str.tostring(pct, "#") + "%"
    f_row(dash, 3, "Price in range", zoneTxt, close > nz(eq, close) ? C_BEAR : C_BULL)
    string kzTxt = inLondon ? "London" : inNYAM ? "New York AM" : inLC ? "London close" : inNYPM ? "New York PM" : inAsia ? "Asia" : "-"
    f_row(dash, 4, "Killzone", kzTxt, inKzScore ? C_BULL : tc)
    f_row(dash, 5, "Long setup", f_setupTxt(revL, 1), revL.stage > 0 ? C_BULL : tc)
    f_row(dash, 6, "Short setup", f_setupTxt(revS, -1), revS.stage > 0 ? C_BEAR : tc)
    string tradeTxt = "flat"
    color  tradeCol = tc
    if not na(cur)
        tradeTxt := (cur.dir == 1 ? "LONG " : "SHORT ") + (cur.status == 0 ? "limit @ " : "open @ ") + f_px(cur.status == 0 ? cur.entry : cur.fillPrice)
        tradeCol := cur.dir == 1 ? C_BULL : C_BEAR
    f_row(dash, 7, "Trade", tradeTxt, tradeCol)
    if not na(cur)
        f_row(dash, 8, "Stop / target", f_px(cur.slCur) + " / " + f_px(cur.tp), tc)
    else
        f_row(dash, 8, "Stop / target", "-", tc)
    float wr = stats.trades > 0 ? stats.wins * 100.0 / stats.trades : 0.0
    float pf = stats.grossL > 0 ? stats.grossW / stats.grossL : na
    f_row(dash, 9, "Trades / win rate", str.tostring(stats.trades) + " / " + str.tostring(wr, "#") + "%", tc)
    f_row(dash, 10, "Total R / PF", (stats.sumR >= 0 ? "+" : "") + str.tostring(stats.sumR, "#.#") + "R / " + (na(pf) ? "-" : str.tostring(pf, "#.##")), stats.sumR >= 0 ? C_BULL : C_BEAR)

// ------------------------------------------------------------------ alerts

if alertJson and placed
    int    d     = pick
    bool   isRev = d == 1 ? revPickL : revPickS
    float  e     = d == 1 ? sigEL : sigES
    float  sl    = d == 1 ? sigSLL : sigSLS
    float  tp    = d == 1 ? sigTPL : sigTPS
    float  rr    = d == 1 ? sigRRL : sigRRS
    float  ra    = d == 1 ? sigRAL : sigRAS
    int    sc    = d == 1 ? sigScL : sigScS
    bool   pdOk  = d == 1 ? sigPdL : sigPdS
    bool   confl = d == 1 ? sigCfL : sigCfS
    bool   disp  = d == 1 ? sigDsL : sigDsS
    bool   zf    = d == 1 ? sigZfL : sigZfS
    bool   maj   = isRev and (d == 1 ? revL.major : revS.major)
    string feats = "{\"htf_aligned\":" + (htfTrend == d ? "1" : "0") + ",\"htf_opposed\":" + (htfTrend == -d ? "1" : "0") + ",\"swing_aligned\":" + (swgS.trend == d ? "1" : "0") + ",\"killzone\":" + (inKzScore ? "1" : "0") + ",\"pd_ok\":" + (pdOk ? "1" : "0") + ",\"major_sweep\":" + (maj ? "1" : "0") + ",\"zone_confluence\":" + (confl ? "1" : "0") + ",\"displacement\":" + (disp ? "1" : "0") + ",\"model_reversal\":" + (isRev ? "1" : "0") + ",\"zone_fvg\":" + (zf ? "1" : "0") + ",\"is_long\":" + (d == 1 ? "1" : "0") + ",\"rr\":" + str.tostring(rr, "#.####") + ",\"risk_atr\":" + str.tostring(ra, "#.####") + "}"
    string js = "{\"passphrase\":\"" + passphrase + "\",\"event\":\"setup\",\"ticker\":\"" + syminfo.ticker + "\",\"exchange\":\"" + syminfo.prefix + "\",\"tf\":\"" + timeframe.period + "\",\"side\":\"" + (d == 1 ? "long" : "short") + "\",\"model\":\"" + (isRev ? "reversal" : "continuation") + "\",\"entry\":" + f_num(e) + ",\"sl\":" + f_num(sl) + ",\"tp\":" + f_num(tp) + ",\"rr\":" + str.tostring(rr, "#.###") + ",\"score\":" + str.tostring(sc) + ",\"grade\":\"" + f_grade(sc) + "\",\"expiry_bars\":" + str.tostring(entryExpiry) + ",\"features\":" + feats + ",\"time\":" + str.tostring(time) + "}"
    alert(js, alert.freq_once_per_bar_close)
