const color C_BULL = #089981
const color C_BEAR = #F23645

// ------------------------------------------------------------------ types
type Pivot
    float  price
    int    bar
    string tag     = ""
    bool   crossed = false

type Structure
    Pivot hi
    Pivot lo
    Pivot prevHi
    Pivot prevLo
    int   trend = 0
    float trailTop
    float trailBot
    int   trailTopBar
    int   trailBotBar

type Zone
    string kind
    int    dir
    float  top
    float  bottom
    int    left
    int    created
    string level   = ""
    bool   touched = false
    bool   alive   = true
    box    bx
    line   ce

type Level
    float  price
    int    side
    string kind
    int    bar
    bool   major = false
    line   ln
    label  lb

type Rev
    int    stage = 0
    float  ext
    int    extBar
    bool   major = false
    string kinds = ""
    int    mssBar
    string mssKind = ""
    float  mssPrice
    Zone   mssOb

type Trade
    int    dir
    string model
    float  entry
    float  sl
    float  slCur
    float  tp
    float  risk
    int    sigBar
    int    status  = 0
    int    fillBar
    float  fillPrice
    bool   beMoved = false
    line   lE
    line   lS
    line   lT
    box    bT
    box    bS
    float  tp1
    bool   tp1Done  = false
    float  partFrac = 0.0
    float  partPrice
    line   lT1
    int    hIdx     = 0
    string grade    = ""

type Stats
    int   trades = 0
    int   wins   = 0
    int   losses = 0
    float sumR   = 0.0
    float grossW = 0.0
    float grossL = 0.0

type GuardState
    float  dayR       = 0.0
    float  weekR      = 0.0
    float  cumR       = 0.0
    float  peakR      = 0.0
    int    consec     = 0
    int    pauseUntil = -1
    bool   halted     = false
    int    shockUntil = -1
    string shockWhy   = ""

type TFS
    int    sec
    string lbl
    bool   up
    bool   use
    int    trend
    float  top
    float  bot
    float  swH
    float  swL
    float  bT
    float  bB
    float  sT
    float  sB

// ------------------------------------------------------------------ helpers
f_px(float x) =>
    str.tostring(x, format.mintick)

f_num(float x) =>
    str.tostring(math.round_to_mintick(x), "#.##########")

f_grade(int score) =>
    score >= 8 ? "A+" : score >= 6 ? "A" : score >= 4 ? "B" : "C"

f_trendTxt(int t) =>
    t == 1 ? "Bullish" : t == -1 ? "Bearish" : "-"

f_autoHTF() =>
    int sec = timeframe.in_seconds()
    sec <= 60 ? "15" : sec <= 300 ? "60" : sec <= 3600 ? "240" : sec <= 14400 ? "D" : "W"

method record(Stats st, float r) =>
    st.trades += 1
    st.sumR   += r
    if r > 1e-9
        st.wins   += 1
        st.grossW += r
    else if r < -1e-9
        st.losses += 1
        st.grossL -= r

method onClosed(GuardState g, float r) =>
    g.cumR  += r
    g.dayR  += r
    g.weekR += r
    g.peakR := math.max(g.peakR, g.cumR)
    if maxDDR > 0 and g.peakR - g.cumR >= maxDDR
        g.halted := true
    if r < -1e-9
        g.consec += 1
        if maxConsec > 0 and g.consec >= maxConsec
            g.pauseUntil := bar_index + lossPause
            g.consec     := 0
    else if r > 1e-9
        g.consec := 0

f_hm(string s) =>
    int(str.tonumber(str.substring(s, 0, 2))) * 60 + int(str.tonumber(str.substring(s, 3, 5)))

f_pad2(int x) =>
    x < 10 ? "0" + str.tostring(x) : str.tostring(x)

f_inRange(int m, int a, int b) =>
    a <= b ? (m >= a and m < b) : (m >= a or m < b)

f_add(string a, string b) =>
    a == "" ? b : b == "" ? a : a + "\n" + b

f_tfLabel(int sec) =>
    int mins = int(sec / 60)
    mins % 10080 == 0 ? "W" : mins % 1440 == 0 ? "D" : mins % 60 == 0 ? "H" + str.tostring(int(mins / 60)) : "M" + str.tostring(mins)

f_rangePos(TFS tf, float price) =>
    float pos = na
    if not na(tf.top) and not na(tf.bot) and tf.top > tf.bot
        pos := (price - tf.bot) / (tf.top - tf.bot)
    pos

// state of one higher timeframe from its *completed* candles (all values [1]):
// trend, trailing range, unbroken swing high/low, latest unfilled bull/bear FVG, previous candle H/L
f_mtf(int n) =>
    [ph, pl] = f_pivots(n)
    var int   trend = 0
    var float hiP   = na
    var bool  hiX   = true
    var float loP   = na
    var bool  loX   = true
    var float tTop  = na
    var float tBot  = na
    var float bT    = na
    var float bB    = na
    var float sT    = na
    var float sB    = na
    if not na(bB) and low <= bB
        bT := na
        bB := na
    if not na(sT) and high >= sT
        sT := na
        sB := na
    if not na(ph)
        hiP  := ph
        hiX  := false
        tTop := ph
    if not na(pl)
        loP  := pl
        loX  := false
        tBot := pl
    if not na(tTop) and high > tTop
        tTop := high
    if not na(tBot) and low < tBot
        tBot := low
    if not hiX and close > hiP
        hiX   := true
        trend := 1
    if not loX and close < loP
        loX   := true
        trend := -1
    if bar_index >= 2
        if low > high[2] and close[1] > high[2]
            bT := low
            bB := high[2]
        if high < low[2] and close[1] < low[2]
            sT := low[2]
            sB := high
    float swH = hiX ? na : hiP
    float swL = loX ? na : loP
    [trend[1], tTop[1], tBot[1], swH[1], swL[1], bT[1], bB[1], sT[1], sB[1], high[1], low[1]]

f_inSess(string sess) =>
    not na(time(timeframe.period, sess + ":1234567", "America/New_York"))

// pivot high at bar n bars ago: higher than the n bars before it, >= the n bars after it
f_pivots(int n) =>
    float leftHi  = ta.highest(high, n)[n + 1]
    float rightHi = ta.highest(high, n)
    float leftLo  = ta.lowest(low, n)[n + 1]
    float rightLo = ta.lowest(low, n)
    float ph = na
    float pl = na
    if bar_index >= 2 * n
        if high[n] > leftHi and high[n] >= rightHi
            ph := high[n]
        if low[n] < leftLo and low[n] <= rightLo
            pl := low[n]
    [ph, pl]

// trend of a pivot structure (used inside request.security for the HTF bias)
f_htfTrend(int n) =>
    var int   trend = 0
    var float hiP   = na
    var bool  hiX   = true
    var float loP   = na
    var bool  loX   = true
    [ph, pl] = f_pivots(n)
    if not na(ph)
        hiP := ph
        hiX := false
    if not na(pl)
        loP := pl
        loX := false
    if not hiX and close > hiP
        hiX   := true
        trend := 1
    if not loX and close < loP
        loX   := true
        trend := -1
    trend

method advance(Structure s, float ph, float pl, int n) =>
    if not na(ph)
        string tag = "H"
        if not na(s.hi)
            tag := ph > s.hi.price ? "HH" : "LH"
        s.prevHi      := s.hi
        s.hi          := Pivot.new(ph, bar_index - n, tag, false)
        s.trailTop    := ph
        s.trailTopBar := bar_index - n
    if not na(pl)
        string tag = "L"
        if not na(s.lo)
            tag := pl > s.lo.price ? "HL" : "LL"
        s.prevLo      := s.lo
        s.lo          := Pivot.new(pl, bar_index - n, tag, false)
        s.trailBot    := pl
        s.trailBotBar := bar_index - n
    if not na(s.trailTop)
        if high > s.trailTop
            s.trailTop    := high
            s.trailTopBar := bar_index
    if not na(s.trailBot)
        if low < s.trailBot
            s.trailBot    := low
            s.trailBotBar := bar_index
    bool   bull      = false
    string bullKind  = ""
    float  bullPrice = na
    int    bullPivot = na
    bool   bear      = false
    string bearKind  = ""
    float  bearPrice = na
    int    bearPivot = na
    if not na(s.hi)
        Pivot h = s.hi
        if not h.crossed and close > h.price
            bullKind  := s.trend == -1 ? "CHoCH" : "BOS"
            h.crossed := true
            s.trend   := 1
            bull      := true
            bullPrice := h.price
            bullPivot := h.bar
    if not na(s.lo)
        Pivot l = s.lo
        if not l.crossed and close < l.price
            bearKind  := s.trend == 1 ? "CHoCH" : "BOS"
            l.crossed := true
            s.trend   := -1
            bear      := true
            bearPrice := l.price
            bearPivot := l.bar
    [bull, bullKind, bullPrice, bullPivot, bear, bearKind, bearPrice, bearPivot]

f_kindName(string k, int side) =>
    switch k
        "internal"    => side == 1 ? "iBSL" : "iSSL"
        "swing"       => side == 1 ? "BSL" : "SSL"
        "eqh"         => "EQH"
        "eql"         => "EQL"
        "pdh"         => "PDH"
        "pdl"         => "PDL"
        "asia_high"   => "Asia H"
        "asia_low"    => "Asia L"
        "london_high" => "London H"
        "london_low"  => "London L"
        "pwh"         => "PWH"
        "pwl"         => "PWL"
        => k

// ------------------------------------------------------------------ liquidity levels
f_drawLevel(Level lv) =>
    if showLiq and lv.major and na(lv.ln)
        lv.ln := line.new(lv.bar, lv.price, bar_index, lv.price, color = cLiq, style = line.style_dashed, width = 1, extend = extend.right)
        lv.lb := label.new(bar_index, lv.price, f_kindName(lv.kind, lv.side), style = label.style_label_left, color = color(na), textcolor = cLiq, size = size.tiny)

f_endLevel(Level lv, bool swept) =>
    if not na(lv.ln)
        line.set_extend(lv.ln, extend.none)
        line.set_x2(lv.ln, bar_index)
        if swept
            line.set_style(lv.ln, line.style_dotted)
    if not na(lv.lb)
        label.set_x(lv.lb, bar_index)

f_addLevel(array<Level> levels, float price, int side, string kind, int bar, bool major) =>
    bool found = false
    int sz = levels.size()
    if sz > 0
        for i = 0 to sz - 1
            Level lv = levels.get(i)
            if lv.side == side and lv.price == price
                found := true
                if major and not lv.major
                    lv.major := true
                    lv.kind  := kind
                    f_drawLevel(lv)
                break
    if not found
        Level nl = Level.new(price, side, kind, bar, major)
        levels.push(nl)
        f_drawLevel(nl)
        int cnt       = 0
        int oldestIdx = -1
        int oldestBar = na
        for i = 0 to levels.size() - 1
            Level lv = levels.get(i)
            if lv.side == side
                cnt += 1
                if na(oldestBar) or lv.bar < oldestBar
                    oldestBar := lv.bar
                    oldestIdx := i
        if cnt > maxLevels and oldestIdx >= 0
            Level old = levels.remove(oldestIdx)
            if not na(old.ln)
                line.delete(old.ln)
            if not na(old.lb)
                label.delete(old.lb)
    found

f_replaceLevel(array<Level> levels, string kind, float price, int side, int bar) =>
    if levels.size() > 0
        for i = levels.size() - 1 to 0
            Level lv = levels.get(i)
            if lv.kind == kind
                f_endLevel(lv, false)
                levels.remove(i)
    f_addLevel(levels, price, side, kind, bar, true)

f_sweep(array<Level> levels, bool london) =>
    bool   sslTaken = false
    bool   sslMajor = false
    string sslKinds = ""
    bool   bslTaken = false
    bool   bslMajor = false
    string bslKinds = ""
    if levels.size() > 0
        for i = levels.size() - 1 to 0
            Level lv = levels.get(i)
            bool hit = (lv.side == 1 and high > lv.price) or (lv.side == -1 and low < lv.price)
            if hit
                if lv.side == -1
                    sslTaken := true
                    sslMajor := sslMajor or lv.major
                    sslKinds := sslKinds == "" ? lv.kind : sslKinds + "," + lv.kind
                else
                    bslTaken := true
                    bslMajor := bslMajor or lv.major
                    bslKinds := bslKinds == "" ? lv.kind : bslKinds + "," + lv.kind
                f_endLevel(lv, true)
                bool rejected = lv.side == 1 ? close < lv.price : close > lv.price
                if showSweeps and lv.major
                    string what = (lv.side == 1 ? "Buy-side" : "Sell-side") + " liquidity (" + f_kindName(lv.kind, lv.side) + ") " + (rejected ? "swept and rejected" : "taken")
                    label.new(bar_index, lv.price, "", style = label.style_xcross, color = cLiq, size = size.tiny, tooltip = what)
                if showJudas and london and rejected and (lv.kind == "asia_high" or lv.kind == "asia_low")
                    label.new(bar_index, lv.price, "Judas", style = lv.side == 1 ? label.style_label_down : label.style_label_up, color = color.new(cLiq, 20), textcolor = color.white, size = size.tiny, tooltip = "Judas swing: London ran the Asia " + (lv.side == 1 ? "high" : "low") + " and rejected - expect the real move the other way")
                levels.remove(i)
    [sslTaken, sslMajor, sslKinds, bslTaken, bslMajor, bslKinds]

// ------------------------------------------------------------------ zones
f_zoneColor(Zone z) =>
    z.kind == "OB" ? (z.dir == 1 ? cBullOB : cBearOB) : (z.dir == 1 ? cBullFVG : cBearFVG)

f_drawZone(Zone z) =>
    bool show = z.kind == "FVG" ? showFVG : (showOB and (z.level == "swing" or showIntOB))
    if show and na(z.bx)
        color c = f_zoneColor(z)
        string txt = z.kind == "OB" ? (z.level == "swing" ? "OB" : "iOB") : "FVG"
        z.bx := box.new(z.left, z.top, bar_index, z.bottom, border_color = color.new(c, 55), bgcolor = c, extend = extend.right, text = txt, text_size = size.tiny, text_color = color.new(color.gray, 20), text_halign = text.align_right, text_valign = text.align_center)
        if z.kind == "FVG" and showCE
            z.ce := line.new(z.left, (z.top + z.bottom) / 2, bar_index, (z.top + z.bottom) / 2, color = color.new(c, 20), style = line.style_dotted, width = 1, extend = extend.right)

f_killZone(Zone z) =>
    z.alive := false
    if not na(z.ce)
        line.delete(z.ce)
    if not na(z.bx)
        if keepHistory
            box.set_extend(z.bx, extend.none)
            box.set_right(z.bx, bar_index)
        else
            box.delete(z.bx)

f_pushZone(array<Zone> zs, Zone z) =>
    zs.push(z)
    f_drawZone(z)
    int cnt = 0
    for i = 0 to zs.size() - 1
        if zs.get(i).dir == z.dir
            cnt += 1
    if cnt > maxZones
        for i = 0 to zs.size() - 1
            Zone o = zs.get(i)
            if o.dir == z.dir
                f_killZone(o)
                zs.remove(i)
                break

f_makeOB(array<Zone> obs, int dir, int pivotBar, string level) =>
    int lo    = math.max(pivotBar, bar_index - obLookback, 0)
    int span  = bar_index - lo
    int bestJ = 0
    float best = dir == 1 ? low : high
    if span > 0
        for j = 1 to span
            if dir == 1
                if low[j] < best
                    best  := low[j]
                    bestJ := j
            else
                if high[j] > best
                    best  := high[j]
                    bestJ := j
    int bestBar = bar_index - bestJ
    Zone found = na
    if obs.size() > 0
        for i = 0 to obs.size() - 1
            Zone z = obs.get(i)
            if z.dir == dir and z.left == bestBar
                found := z
                break
    if not na(found)
        if level == "swing" and found.level != "swing"
            found.level := "swing"
            f_drawZone(found)
    else
        found := Zone.new("OB", dir, high[bestJ], low[bestJ], bestBar, bar_index, level)
        f_pushZone(obs, found)
    found

f_toolColor(string kind) =>
    kind == "BRK" ? cBreaker : kind == "IFVG" ? cIFVG : cBPR

f_pushTool(array<Zone> tools, Zone z) =>
    bool show = z.kind == "BRK" ? showBreaker : z.kind == "IFVG" ? showIFVG : showBPR
    if show
        color c = f_toolColor(z.kind)
        string txt = (z.dir == 1 ? "+" : "-") + (z.kind == "BRK" ? "Breaker" : z.kind)
        z.bx := box.new(z.left, z.top, bar_index, z.bottom, border_color = color.new(c, 30), border_style = line.style_dashed, bgcolor = c, extend = extend.right, text = txt, text_size = size.tiny, text_color = color.new(color.gray, 20), text_halign = text.align_right, text_valign = text.align_center)
    tools.push(z)
    int cnt = 0
    for i = 0 to tools.size() - 1
        Zone o = tools.get(i)
        if o.dir == z.dir and o.kind == z.kind
            cnt += 1
    if cnt > maxTools
        for i = 0 to tools.size() - 1
            Zone o = tools.get(i)
            if o.dir == z.dir and o.kind == z.kind
                f_killZone(o)
                tools.remove(i)
                break

f_maintainTools(array<Zone> tools) =>
    if tools.size() > 0
        for i = tools.size() - 1 to 0
            Zone z = tools.get(i)
            if z.created != bar_index
                if z.dir == 1 ? low <= z.top : high >= z.bottom
                    z.touched := true
                bool dead = z.dir == 1 ? close < z.bottom : close > z.top
                if dead or bar_index - z.created > obMaxAge
                    f_killZone(z)
                    tools.remove(i)

f_maintain(array<Zone> zs, int maxAge, array<Zone> tools) =>
    if zs.size() > 0
        for i = zs.size() - 1 to 0
            Zone z = zs.get(i)
            if z.created != bar_index
                bool dead = false
                if z.dir == 1
                    if low <= z.top
                        z.touched := true
                    dead := z.kind == "FVG" ? low <= z.bottom : close < z.bottom
                else
                    if high >= z.bottom
                        z.touched := true
                    dead := z.kind == "FVG" ? high >= z.top : close > z.top
                if dead or bar_index - z.created > maxAge
                    // an order block closed through becomes a breaker; a gap closed through an inverse FVG
                    bool through = z.dir == 1 ? close < z.bottom : close > z.top
                    if dead and through
                        f_pushTool(tools, Zone.new(z.kind == "OB" ? "BRK" : "IFVG", -z.dir, z.top, z.bottom, bar_index, bar_index))
                    f_killZone(z)
                    zs.remove(i)

// balanced price range: a new gap overlapping an opposite gap from the last 20 bars
f_bpr(array<Zone> fvgList, array<Zone> tls, int dirNew, float top, float bottom) =>
    if showBPR and fvgList.size() > 1
        for i = fvgList.size() - 2 to 0
            Zone o = fvgList.get(i)
            if o.dir == -dirNew and bar_index - o.created <= 20 and o.bottom < top and bottom < o.top
                float bt = math.min(o.top, top)
                float bb = math.max(o.bottom, bottom)
                if bt > bb
                    f_pushTool(tls, Zone.new("BPR", dirNew, bt, bb, math.min(o.left, bar_index - 1), bar_index))
                break

f_latestFvg(array<Zone> fvgs, int d, int since) =>
    Zone res = na
    if fvgs.size() > 0
        for i = fvgs.size() - 1 to 0
            Zone z = fvgs.get(i)
            if z.dir == d and z.created >= since and z.alive
                res := z
                break
    res

f_overlapAny(array<Zone> zs, int d, float top, float bottom) =>
    bool res = false
    if zs.size() > 0
        for i = 0 to zs.size() - 1
            Zone z = zs.get(i)
            if z.dir == d and z.bottom <= top and bottom <= z.top
                res := true
                break
    res

f_drawBreak(int pivotBar, float price, int d, string kind, bool internal) =>
    color c = d == 1 ? C_BULL : C_BEAR
    line.new(pivotBar, price, bar_index, price, color = c, style = internal ? line.style_dashed : line.style_solid, width = 1)
    label.new(math.round((pivotBar + bar_index) / 2), price, internal ? "i" + kind : kind, style = d == 1 ? label.style_label_down : label.style_label_up, color = color(na), textcolor = c, size = size.tiny)

// ------------------------------------------------------------------ entry models
f_reversal(Rev st, int d, bool taken, bool takenMajor, string takenKinds, bool brk, string brkKind, float brkPrice, Zone newOb, array<Zone> fvgs) =>
    float extNow = d == 1 ? low : high
    bool beyond = false
    if st.stage > 0
        beyond := d == 1 ? extNow < st.ext : extNow > st.ext
    if taken
        if st.stage == 0
            st.stage  := 1
            st.ext    := extNow
            st.extBar := bar_index
            st.major  := takenMajor
            st.kinds  := takenKinds
        else if beyond
            st.stage  := 1
            st.ext    := extNow
            st.extBar := bar_index
            st.major  := st.major or takenMajor
            st.kinds  := st.kinds + "," + takenKinds
        else if st.stage == 1
            st.major  := st.major or takenMajor
            st.kinds  := st.kinds + "," + takenKinds
    else if beyond
        st.stage  := 1
        st.ext    := extNow
        st.extBar := bar_index
    if st.stage == 1 and bar_index - st.extBar > mssWindow
        st.stage := 0
    if st.stage == 1 and brk
        st.stage    := 2
        st.mssBar   := bar_index
        st.mssKind  := brkKind
        st.mssPrice := brkPrice
        st.mssOb    := newOb
    Zone zone = na
    if st.stage == 2
        zone := f_latestFvg(fvgs, d, st.extBar + 2)
        if na(zone)
            if bar_index - st.mssBar >= fvgWait
                if useObEntry and not na(st.mssOb)
                    if st.mssOb.alive
                        zone := st.mssOb
                if na(zone)
                    st.stage := 0
        if not na(zone)
            st.stage := 0
    zone

f_cont(int d, bool brk, string brkKind, int swingTrend, Pivot anchor, Zone newOb, array<Zone> fvgs) =>
    Zone zone = na
    if brk and brkKind == "BOS" and swingTrend == d and not na(anchor)
        zone := f_latestFvg(fvgs, d, anchor.bar + 2)
        if na(zone) and useObEntry and not na(newOb)
            if newOb.alive
                zone := newOb
    zone

// entry / target / confluence score for a candidate zone
f_build(int d, Zone zone, float sl, bool majorSweep, array<Level> levels, array<Zone> obs, array<Zone> fvgs, int htf, int swingTrend, float eq, bool inKz, float atrV, float legOrigin, int legBar) =>
    bool   ok      = false
    float  entry   = na
    float  tp      = na
    float  rr      = na
    float  riskAtr = na
    int    score   = 0
    string tpKind  = ""
    bool   pdOk    = false
    bool   confl   = false
    bool   disp    = false
    float  retr    = na
    float  legFar  = na
    if not na(zone) and not na(sl) and atrV > 0
        entry := entryMode == "CE (50%)" ? (zone.top + zone.bottom) / 2 : (d == 1 ? zone.top : zone.bottom)
        float risk = (entry - sl) * d
        if risk > 0
            riskAtr := risk / atrV
            if riskAtr >= minRiskAtr and riskAtr <= maxRiskAtr
                float bestDist  = na
                float bestPrice = na
                string bestKind = ""
                if tpMode == "Liquidity" and levels.size() > 0
                    for i = 0 to levels.size() - 1
                        Level lv = levels.get(i)
                        float dist = (lv.price - entry) * d
                        if lv.side == d and dist > 0 and dist / risk >= minRR
                            if na(bestDist) or dist < bestDist
                                bestDist  := dist
                                bestPrice := lv.price
                                bestKind  := lv.kind
                if not na(bestDist) and bestDist / risk <= maxRR
                    tp     := bestPrice
                    tpKind := f_kindName(bestKind, d)
                else
                    tp     := entry + d * rrTarget * risk
                    tpKind := str.tostring(rrTarget) + "R"
                rr := (tp - entry) * d / risk
                if rr >= minRR - 1e-9
                    pdOk := not na(eq) and (d == 1 ? entry < eq : entry > eq)
                    float body = 0.0
                    if zone.kind == "FVG"
                        int off = bar_index - zone.left
                        body  := math.abs(close[off] - open[off])
                        confl := f_overlapAny(obs, d, zone.top, zone.bottom)
                    else
                        int span = bar_index - zone.left
                        for j = 0 to span
                            body := math.max(body, math.abs(close[j] - open[j]))
                        confl := f_overlapAny(fvgs, d, zone.top, zone.bottom)
                    disp  := body >= dispAtr * atrV
                    if not na(legOrigin) and not na(legBar)
                        int legSpan = math.min(bar_index - math.max(legBar, 0), 900)
                        float far = d == 1 ? high : low
                        if legSpan > 0
                            for j = 1 to legSpan
                                far := d == 1 ? math.max(far, high[j]) : math.min(far, low[j])
                        legFar := far
                        if d == 1 and far > legOrigin
                            retr := (far - entry) / (far - legOrigin)
                        else if d == -1 and legOrigin > far
                            retr := (entry - far) / (legOrigin - far)
                    score := (htf == d ? 2 : 0) + (pdOk ? 2 : 0) + (majorSweep ? 1 : 0) + (confl ? 1 : 0) + (inKz ? 1 : 0) + (disp ? 1 : 0) + (swingTrend == d ? 1 : 0) + (rr >= 3.0 ? 1 : 0)
                    ok := true
                    if htfFilter and htf != d
                        ok := false
                    if kzFilter and not inKz
                        ok := false
                    if score < minScore
                        ok := false
    [ok, entry, tp, rr, riskAtr, score, tpKind, pdOk, confl, disp, retr, legFar]

// ===================================================================== per-bar engine
// 0) manage the tracked trade with this bar (orders were placed on earlier bars)
var Trade      cur   = na
var Stats      stats = Stats.new()
var GuardState gs    = GuardState.new()
// results of past setups on THIS chart, by model (reversal / continuation) x grade (A+, A, B/C)
var array<int>   hN = array.new<int>(6, 0)
var array<int>   hW = array.new<int>(6, 0)
var array<float> hR = array.new<float>(6, 0.0)

f_hIdx(bool isRev, int score) =>
    (isRev ? 0 : 3) + (score >= 8 ? 0 : score >= 6 ? 1 : 2)

f_histAdd(int idx, float r) =>
    hN.set(idx, hN.get(idx) + 1)
    hW.set(idx, hW.get(idx) + (r > 1e-9 ? 1 : 0))
    hR.set(idx, hR.get(idx) + r)

f_hist(int idx) =>
    int    n   = hN.get(idx)
    string grp = (idx < 3 ? "reversal " : "continuation ") + (idx % 3 == 0 ? "A+" : idx % 3 == 1 ? "A" : "B/C")
    n == 0 ? "This chart: no closed " + grp + " setup yet" : "This chart: " + str.tostring(n) + " closed " + grp + " setups, " + str.tostring(hW.get(idx) * 100.0 / n, "#") + "% won, avg " + (hR.get(idx) >= 0 ? "+" : "") + str.tostring(hR.get(idx) / n, "#.##") + "R"
if timeframe.change("D")
    gs.dayR := 0.0
if timeframe.change("W")
    gs.weekR := 0.0
bool   evFill     = false
bool   evExit     = false
bool   evCancel   = false
bool   evTp1      = false
int    evDir      = 0
float  exitPrice  = na
float  exitR      = na
string exitReason = ""
string symTf      = syminfo.ticker + " " + timeframe.period
if not na(cur)
    int d = cur.dir
    evDir := d
    if cur.status == 0
        if bar_index - cur.sigBar > entryExpiry
            evCancel   := true
            exitReason := "expired"
        else
            bool gap   = d == 1 ? open <= cur.entry : open >= cur.entry
            bool touch = d == 1 ? low <= cur.entry : high >= cur.entry
            if gap or touch
                cur.status    := 1
                cur.fillPrice := gap ? open : cur.entry
                cur.fillBar   := bar_index
                evFill        := true
                bool stopped = d == 1 ? low <= cur.slCur : high >= cur.slCur
                if stopped
                    bool gapStop = d == 1 ? open <= cur.slCur : open >= cur.slCur
                    exitPrice  := gapStop ? open : cur.slCur
                    exitReason := "sl"
                    evExit     := true
            else if (d == 1 ? high >= cur.tp : low <= cur.tp)
                evCancel   := true
                exitReason := "missed"
    else
        bool tp1Live = not na(cur.tp1) and not cur.tp1Done
        float xp = na
        string xr = ""
        if d == 1
            if open <= cur.slCur
                xp := open
                xr := cur.beMoved ? "be" : "sl"
            else if low <= cur.slCur
                xp := cur.slCur
                xr := cur.beMoved ? "be" : "sl"
            else if open >= cur.tp
                xp := open
                xr := "tp"
                if tp1Live
                    cur.partFrac  := tp1Pct / 100
                    cur.partPrice := open
            else if high >= cur.tp
                xp := cur.tp
                xr := "tp"
                if tp1Live
                    cur.partFrac  := tp1Pct / 100
                    cur.partPrice := math.max(cur.tp1, open)
        else
            if open >= cur.slCur
                xp := open
                xr := cur.beMoved ? "be" : "sl"
            else if high >= cur.slCur
                xp := cur.slCur
                xr := cur.beMoved ? "be" : "sl"
            else if open <= cur.tp
                xp := open
                xr := "tp"
                if tp1Live
                    cur.partFrac  := tp1Pct / 100
                    cur.partPrice := open
            else if low <= cur.tp
                xp := cur.tp
                xr := "tp"
                if tp1Live
                    cur.partFrac  := tp1Pct / 100
                    cur.partPrice := math.min(cur.tp1, open)
        if not na(xp)
            exitPrice  := xp
            exitReason := xr
            evExit     := true
        else if tp1Live and (d == 1 ? high >= cur.tp1 : low <= cur.tp1)
            // first target: take part of the profit, the rest runs risk-free
            bool gapT1 = d == 1 ? open >= cur.tp1 : open <= cur.tp1
            cur.partFrac  := tp1Pct / 100
            cur.partPrice := gapT1 ? open : cur.tp1
            cur.tp1Done   := true
            cur.slCur     := cur.fillPrice
            cur.beMoved   := true
            evTp1         := true
            //@@TP1
        else if beAtR > 0 and not cur.beMoved
            float trig = cur.entry + d * beAtR * cur.risk
            if (d == 1 ? high >= trig : low <= trig)
                cur.slCur   := cur.fillPrice
                cur.beMoved := true
                //@@BE

// trade drawings / stats / notifications
if not na(cur) and evFill
    if showTrades
        line.delete(cur.lE)
        line.delete(cur.lS)
        line.delete(cur.lT)
        cur.bT := box.new(bar_index, cur.tp, bar_index + 1, cur.entry, border_color = color.new(C_BULL, 60), bgcolor = color.new(C_BULL, 85))
        cur.bS := box.new(bar_index, cur.entry, bar_index + 1, cur.sl, border_color = color.new(C_BEAR, 60), bgcolor = color.new(C_BEAR, 85))
        if not na(cur.lT1)
            line.set_xy1(cur.lT1, bar_index, cur.tp1)
            line.set_x2(cur.lT1, bar_index + 1)
        if showStages
            label.new(bar_index, cur.fillPrice, "4", style = label.style_circle, color = color.new(cur.dir == 1 ? C_BULL : C_BEAR, 10), textcolor = color.white, size = size.tiny, tooltip = "Step 4: entry filled at " + f_px(cur.fillPrice))
    if alertFill and readableOn
        alert((cur.dir == 1 ? "BUY" : "SELL") + " FILLED - " + symTf + "\nEntry " + f_px(cur.fillPrice) + " | SL " + f_px(cur.sl) + (na(cur.tp1) ? "" : " | TP1 " + f_px(cur.tp1)) + " | TP " + f_px(cur.tp), alert.freq_once_per_bar_close)
if not na(cur) and not evExit and not evFill and showTrades
    if cur.status == 1
        box.set_right(cur.bT, bar_index + 1)
        box.set_right(cur.bS, bar_index + 1)
        if not na(cur.lT1)
            line.set_x2(cur.lT1, bar_index + 1)
if not na(cur) and evTp1
    float r1 = (cur.partPrice - cur.fillPrice) * cur.dir / cur.risk
    if showTrades
        label.new(bar_index, cur.partPrice, "TP1", style = cur.dir == 1 ? label.style_label_down : label.style_label_up, color = color.new(#FFB300, 10), textcolor = color.black, size = size.tiny, tooltip = str.tostring(tp1Pct) + "% closed at " + f_px(cur.partPrice) + " (" + (r1 >= 0 ? "+" : "") + str.tostring(r1, "#.##") + "R); stop moved to entry")
    if alertFill and readableOn
        alert("TP1 HIT - " + symTf + "\n" + str.tostring(tp1Pct) + "% closed at " + f_px(cur.partPrice) + " (+" + str.tostring(r1, "#.##") + "R). Stop moved to entry " + f_px(cur.fillPrice) + " - the rest runs risk-free to " + f_px(cur.tp), alert.freq_once_per_bar_close)
if not na(cur) and evExit
    float rest = (exitPrice - cur.fillPrice) * cur.dir / cur.risk
    exitR := cur.partFrac > 0 ? cur.partFrac * (cur.partPrice - cur.fillPrice) * cur.dir / cur.risk + (1 - cur.partFrac) * rest : rest
    stats.record(exitR)
    gs.onClosed(exitR)
    f_histAdd(cur.hIdx, exitR)
    string why = exitReason == "tp" ? "target hit" : exitReason == "sl" ? "stop loss" : exitReason == "be" ? "stopped at entry after TP1 / breakeven" : exitReason
    if showTrades
        box.set_right(cur.bT, bar_index)
        box.set_right(cur.bS, bar_index)
        if not na(cur.lT1)
            line.set_x2(cur.lT1, bar_index)
        label.new(bar_index, exitPrice, (exitR >= 0 ? "+" : "") + str.tostring(exitR, "#.##") + "R", style = label.style_label_left, color = color(na), textcolor = exitR > 0 ? C_BULL : exitR < 0 ? C_BEAR : color.gray, size = size.small, tooltip = cur.model + " " + cur.grade + ": " + why)
    if alertFill and readableOn
        alert("TRADE CLOSED - " + symTf + " " + (cur.dir == 1 ? "long" : "short") + "\n" + why + " at " + f_px(exitPrice) + " | result " + (exitR >= 0 ? "+" : "") + str.tostring(exitR, "#.##") + "R", alert.freq_once_per_bar_close)
    cur := na
if not na(cur) and evCancel
    //@@CANCEL
    if showTrades
        for ln in array.from(cur.lE, cur.lS, cur.lT)
            line.set_x2(ln, bar_index)
            line.set_color(ln, color.new(color.gray, 50))
        if not na(cur.lT1)
            line.set_x2(cur.lT1, bar_index)
            line.set_color(cur.lT1, color.new(color.gray, 50))
    if alertFill and readableOn
        alert("ORDER CANCELLED - " + symTf + " " + (cur.dir == 1 ? "buy" : "sell") + " limit " + f_px(cur.entry) + ": " + (exitReason == "missed" ? "price reached the target before the entry" : "not filled in time"), alert.freq_once_per_bar_close)
    cur := na

// 1) volatility, higher-timeframe bias, killzones
float  atr      = ta.atr(atrLen)
string htfTF    = htfInput == "" ? f_autoHTF() : htfInput
int    htfTrend = nz(request.security(syminfo.tickerid, htfTF, f_htfTrend(htfLen)[1], lookahead = barmerge.lookahead_on))
bool inAsia   = f_inSess(kzAsia)
bool inLondon = f_inSess(kzLondon)
bool inNYAM   = f_inSess(kzNYAM)
bool inLC     = f_inSess(kzLC)
bool inNYPM   = f_inSess(kzNYPM)
bool inKzScore = (useAsia and inAsia) or (useLondon and inLondon) or (useNYAM and inNYAM) or (useLC and inLC) or (useNYPM and inNYPM)

// 2) session ranges and previous day -> liquidity
var array<Level> levels = array.new<Level>()
var float asH = na
var float asL = na
var bool  asAct = false
var int   asStart = na
if inAsia
    if not asAct
        asAct   := true
        asH     := high
        asL     := low
        asStart := bar_index
    else
        asH := math.max(asH, high)
        asL := math.min(asL, low)
else if asAct
    asAct := false
    f_replaceLevel(levels, "asia_high", asH, 1, asStart)
    f_replaceLevel(levels, "asia_low", asL, -1, asStart)

var float loH = na
var float loL = na
var bool  loAct = false
var int   loStart = na
if inLondon
    if not loAct
        loAct   := true
        loH     := high
        loL     := low
        loStart := bar_index
    else
        loH := math.max(loH, high)
        loL := math.min(loL, low)
else if loAct
    loAct := false
    f_replaceLevel(levels, "london_high", loH, 1, loStart)
    f_replaceLevel(levels, "london_low", loL, -1, loStart)

var float dH = na
var float dL = na
var int   dStart = na
if timeframe.change("D") or na(dH)
    if not na(dH)
        f_replaceLevel(levels, "pdh", dH, 1, dStart)
        f_replaceLevel(levels, "pdl", dL, -1, dStart)
    dH     := high
    dL     := low
    dStart := bar_index
else
    dH := math.max(dH, high)
    dL := math.min(dL, low)

var float wH = na
var float wL = na
var int   wStart = na
if timeframe.change("W") or na(wH)
    if not na(wH)
        f_replaceLevel(levels, "pwh", wH, 1, wStart)
        f_replaceLevel(levels, "pwl", wL, -1, wStart)
    wH     := high
    wL     := low
    wStart := bar_index
else
    wH := math.max(wH, high)
    wL := math.min(wL, low)

// 3) market structure
var Structure intS = Structure.new()
var Structure swgS = Structure.new()
[iPH, iPL] = f_pivots(intLen)
[sPH, sPL] = f_pivots(swingLen)
[iBull, iBullKind, iBullPrice, iBullPivot, iBear, iBearKind, iBearPrice, iBearPivot] = intS.advance(iPH, iPL, intLen)
[sBull, sBullKind, sBullPrice, sBullPivot, sBear, sBearKind, sBearPrice, sBearPivot] = swgS.advance(sPH, sPL, swingLen)

// 4) pivots -> liquidity, equal highs / lows
float eqTolPx = na(atr) ? 0.0 : atr * eqTol
if not na(iPH)
    f_addLevel(levels, iPH, 1, "internal", bar_index - intLen, false)
    if not na(intS.prevHi) and eqTolPx > 0
        if math.abs(iPH - intS.prevHi.price) <= eqTolPx
            float eqp = math.max(iPH, intS.prevHi.price)
            f_addLevel(levels, eqp, 1, "eqh", bar_index - intLen, true)
            if showLiq
                line.new(intS.prevHi.bar, eqp, bar_index - intLen, eqp, color = cLiq, style = line.style_dotted)
                label.new(bar_index - intLen, eqp, "EQH", style = label.style_label_down, color = color(na), textcolor = cLiq, size = size.tiny)
if not na(iPL)
    f_addLevel(levels, iPL, -1, "internal", bar_index - intLen, false)
    if not na(intS.prevLo) and eqTolPx > 0
        if math.abs(iPL - intS.prevLo.price) <= eqTolPx
            float eqp = math.min(iPL, intS.prevLo.price)
            f_addLevel(levels, eqp, -1, "eql", bar_index - intLen, true)
            if showLiq
                line.new(intS.prevLo.bar, eqp, bar_index - intLen, eqp, color = cLiq, style = line.style_dotted)
                label.new(bar_index - intLen, eqp, "EQL", style = label.style_label_up, color = color(na), textcolor = cLiq, size = size.tiny)
if not na(sPH)
    f_addLevel(levels, sPH, 1, "swing", bar_index - swingLen, true)
    if showSwingPts
        label.new(bar_index - swingLen, sPH, swgS.hi.tag, style = label.style_label_down, color = color(na), textcolor = color.new(color.gray, 10), size = size.tiny)
if not na(sPL)
    f_addLevel(levels, sPL, -1, "swing", bar_index - swingLen, true)
    if showSwingPts
        label.new(bar_index - swingLen, sPL, swgS.lo.tag, style = label.style_label_up, color = color(na), textcolor = color.new(color.gray, 10), size = size.tiny)

// 5) liquidity sweeps
[sslTaken, sslMajor, sslKinds, bslTaken, bslMajor, bslKinds] = f_sweep(levels, inLondon)

// 6) order blocks from every break (internal first, bullish first)
var array<Zone> obs   = array.new<Zone>()
var array<Zone> tools = array.new<Zone>()  // breakers, inverse FVGs, BPRs (visual confirmations only)
Zone iBullOb = na
Zone iBearOb = na
if iBull
    iBullOb := f_makeOB(obs, 1, iBullPivot, "internal")
if iBear
    iBearOb := f_makeOB(obs, -1, iBearPivot, "internal")
if sBull
    f_makeOB(obs, 1, sBullPivot, "swing")
if sBear
    f_makeOB(obs, -1, sBearPivot, "swing")
if iBull and showIntStr
    f_drawBreak(iBullPivot, iBullPrice, 1, iBullKind, true)
if iBear and showIntStr
    f_drawBreak(iBearPivot, iBearPrice, -1, iBearKind, true)
if sBull and showSwingStr
    f_drawBreak(sBullPivot, sBullPrice, 1, sBullKind, false)
if sBear and showSwingStr
    f_drawBreak(sBearPivot, sBearPrice, -1, sBearKind, false)

// 7) fair value gaps
var array<Zone> fvgs = array.new<Zone>()
if not na(atr) and bar_index >= 2
    float minGap = fvgMinAtr * atr
    if low > high[2] and close[1] > high[2] and (low - high[2]) >= minGap
        f_pushZone(fvgs, Zone.new("FVG", 1, low, high[2], bar_index - 1, bar_index))
        f_bpr(fvgs, tools, 1, low, high[2])
    if high < low[2] and close[1] < low[2] and (low[2] - high) >= minGap
        f_pushZone(fvgs, Zone.new("FVG", -1, low[2], high, bar_index - 1, bar_index))
        f_bpr(fvgs, tools, -1, low[2], high)

// 8) zone touches / invalidation
f_maintain(obs, obMaxAge, tools)
f_maintain(fvgs, fvgMaxAge, tools)
f_maintainTools(tools)

// 9) entry models
var Rev revL = Rev.new()
var Rev revS = Rev.new()
float eq    = na(swgS.trailTop) or na(swgS.trailBot) ? na : (swgS.trailTop + swgS.trailBot) / 2
bool  ready = not na(atr) and bar_index >= 2 * math.max(swingLen, intLen)

Zone  zLr  = na
float slLr = na
Zone  zSr  = na
float slSr = na
int   stBeforeL = revL.stage
int   stBeforeS = revS.stage
if ready and useRev
    zLr := f_reversal(revL, 1, sslTaken, sslMajor, sslKinds, iBull, iBullKind, iBullPrice, iBullOb, fvgs)
    if not na(zLr)
        slLr := revL.ext - slBufAtr * atr
    zSr := f_reversal(revS, -1, bslTaken, bslMajor, bslKinds, iBear, iBearKind, iBearPrice, iBearOb, fvgs)
    if not na(zSr)
        slSr := revS.ext + slBufAtr * atr
[okLr, eLr, tpLr, rrLr, raLr, scLr, tkLr, pdLr, cfLr, dsLr, reLr, fLr] = f_build(1, zLr, slLr, revL.major, levels, obs, fvgs, htfTrend, swgS.trend, eq, inKzScore, atr, revL.ext, revL.extBar)
[okSr, eSr, tpSr, rrSr, raSr, scSr, tkSr, pdSr, cfSr, dsSr, reSr, fSr] = f_build(-1, zSr, slSr, revS.major, levels, obs, fvgs, htfTrend, swgS.trend, eq, inKzScore, atr, revS.ext, revS.extBar)

// setup steps on the chart: 1 liquidity taken, 2 market structure shift, 3 entry zone (the BUY / SELL label)
bool formingL = ready and useRev and revL.mssBar == bar_index
bool formingS = ready and useRev and revS.mssBar == bar_index
if showStages and ready and useRev
    if stBeforeL == 0 and revL.stage >= 1 and revL.major
        label.new(bar_index, low, "1", style = label.style_circle, color = color.new(C_BULL, 35), textcolor = color.white, size = size.tiny, tooltip = "Step 1 (long): sell-side liquidity taken (" + revL.kinds + ") at " + f_px(revL.ext))
    if stBeforeS == 0 and revS.stage >= 1 and revS.major
        label.new(bar_index, high, "1", style = label.style_circle, color = color.new(C_BEAR, 35), textcolor = color.white, size = size.tiny, tooltip = "Step 1 (short): buy-side liquidity taken (" + revS.kinds + ") at " + f_px(revS.ext))
    if formingL
        label.new(bar_index, revL.mssPrice, "2", style = label.style_circle, color = color.new(C_BULL, 10), textcolor = color.white, size = size.tiny, tooltip = "Step 2 (long): market structure shift (" + revL.mssKind + ") through " + f_px(revL.mssPrice) + " after the sweep of " + f_px(revL.ext) + " - waiting for the entry zone")
    if formingS
        label.new(bar_index, revS.mssPrice, "2", style = label.style_circle, color = color.new(C_BEAR, 10), textcolor = color.white, size = size.tiny, tooltip = "Step 2 (short): market structure shift (" + revS.mssKind + ") through " + f_px(revS.mssPrice) + " after the sweep of " + f_px(revS.ext) + " - waiting for the entry zone")

Zone  zLc   = na
float slLc  = na
float legLc = na
int   barLc = na
Zone  zSc   = na
float slSc  = na
float legSc = na
int   barSc = na
if ready and useCont and not okLr and iBull
    zLc := f_cont(1, iBull, iBullKind, swgS.trend, intS.lo, iBullOb, fvgs)
    if not na(zLc)
        slLc  := intS.lo.price - slBufAtr * atr
        legLc := intS.lo.price
        barLc := intS.lo.bar
if ready and useCont and not okSr and iBear
    zSc := f_cont(-1, iBear, iBearKind, swgS.trend, intS.hi, iBearOb, fvgs)
    if not na(zSc)
        slSc  := intS.hi.price + slBufAtr * atr
        legSc := intS.hi.price
        barSc := intS.hi.bar
[okLc, eLc, tpLc, rrLc, raLc, scLc, tkLc, pdLc, cfLc, dsLc, reLc, fLc] = f_build(1, zLc, slLc, false, levels, obs, fvgs, htfTrend, swgS.trend, eq, inKzScore, atr, legLc, barLc)
[okSc, eSc, tpSc, rrSc, raSc, scSc, tkSc, pdSc, cfSc, dsSc, reSc, fSc] = f_build(-1, zSc, slSc, false, levels, obs, fvgs, htfTrend, swgS.trend, eq, inKzScore, atr, legSc, barSc)

// final signal per side (reversal has priority, like the agent)
bool   armL    = okLr or okLc
bool   armS    = okSr or okSc
bool   revPickL = okLr
bool   revPickS = okSr
float  sigEL   = revPickL ? eLr : eLc
float  sigSLL  = revPickL ? slLr : slLc
float  sigTPL  = revPickL ? tpLr : tpLc
float  sigRRL  = revPickL ? rrLr : rrLc
float  sigRAL  = revPickL ? raLr : raLc
int    sigScL  = revPickL ? scLr : scLc
string sigTkL  = revPickL ? tkLr : tkLc
bool   sigPdL  = revPickL ? pdLr : pdLc
bool   sigCfL  = revPickL ? cfLr : cfLc
bool   sigDsL  = revPickL ? dsLr : dsLc
float  sigReL  = revPickL ? reLr : reLc
float  sigFarL = revPickL ? fLr : fLc
float  sigOrL  = revPickL ? revL.ext : legLc
int    sigObL  = revPickL ? revL.extBar : barLc
bool   sigOteL = not na(sigReL) and sigReL >= 0.62 and sigReL <= 0.79
float  sigES   = revPickS ? eSr : eSc
float  sigSLS  = revPickS ? slSr : slSc
float  sigTPS  = revPickS ? tpSr : tpSc
float  sigRRS  = revPickS ? rrSr : rrSc
float  sigRAS  = revPickS ? raSr : raSc
int    sigScS  = revPickS ? scSr : scSc
string sigTkS  = revPickS ? tkSr : tkSc
bool   sigPdS  = revPickS ? pdSr : pdSc
bool   sigCfS  = revPickS ? cfSr : cfSc
bool   sigDsS  = revPickS ? dsSr : dsSc
float  sigReS  = revPickS ? reSr : reSc
float  sigFarS = revPickS ? fSr : fSc
float  sigOrS  = revPickS ? revS.ext : legSc
int    sigObS  = revPickS ? revS.extBar : barSc
bool   sigOteS = not na(sigReS) and sigReS >= 0.62 and sigReS <= 0.79
bool sigZfL = false
if okLr
    sigZfL := zLr.kind == "FVG"
else if okLc
    sigZfL := zLc.kind == "FVG"
bool sigZfS = false
if okSr
    sigZfS := zSr.kind == "FVG"
else if okSc
    sigZfS := zSc.kind == "FVG"

// ===================================================================== ICT toolkit (visual confirmations)
bool isIntra    = timeframe.isintraday
int  chartSecTK = timeframe.in_seconds()
// SMT divergence with a correlated market (TradingView-only confirmation)
float oLow  = request.security(smtSym, timeframe.period, low, lookahead = barmerge.lookahead_off)
float oHigh = request.security(smtSym, timeframe.period, high, lookahead = barmerge.lookahead_off)
var int smtBullBar = na
var int smtBearBar = na
if smtOn and not na(iPL) and not na(intS.prevLo)
    int offP = bar_index - intS.prevLo.bar
    if offP > intLen and offP < 900 and iPL < intS.prevLo.price
        float oN = smtInverse ? -oHigh[intLen] : oLow[intLen]
        float oP = smtInverse ? -oHigh[offP] : oLow[offP]
        if not na(oN) and not na(oP) and oN > oP
            smtBullBar := bar_index
            label.new(bar_index - intLen, iPL, "SMT", style = label.style_label_up, color = color.new(#2196F3, 15), textcolor = color.white, size = size.tiny, tooltip = "Bullish SMT: " + syminfo.ticker + " made a lower low but " + smtSym + (smtInverse ? " did not make a higher high" : " made a higher low"))
if smtOn and not na(iPH) and not na(intS.prevHi)
    int offP = bar_index - intS.prevHi.bar
    if offP > intLen and offP < 900 and iPH > intS.prevHi.price
        float oN = smtInverse ? -oLow[intLen] : oHigh[intLen]
        float oP = smtInverse ? -oLow[offP] : oHigh[offP]
        if not na(oN) and not na(oP) and oN < oP
            smtBearBar := bar_index
            label.new(bar_index - intLen, iPH, "SMT", style = label.style_label_down, color = color.new(#2196F3, 15), textcolor = color.white, size = size.tiny, tooltip = "Bearish SMT: " + syminfo.ticker + " made a higher high but " + smtSym + (smtInverse ? " did not make a lower low" : " made a lower high"))

// midnight / 08:30 / weekly opening prices (New York)
int  oNyDay  = dayofmonth(time, "America/New_York")
int  oNyMin  = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
bool newNyDay = oNyDay != oNyDay[1]
bool newWeek  = timeframe.change("W")
var float midOpen = na
var line  lMid = na
var line  l830 = na
var line  lWk  = na
if newNyDay
    midOpen := open
    if showOpens and isIntra
        line.delete(lMid)
        lMid := line.new(bar_index, open, bar_index + 1, open, color = color.new(#E0E0E0, 20), style = line.style_dotted, extend = extend.right)
        label.new(bar_index, open, "Midnight open", style = label.style_none, textcolor = color.new(#9E9E9E, 0), size = size.tiny)
if oNyMin >= 510 and (oNyMin[1] < 510 or newNyDay) and showOpens and isIntra
    line.delete(l830)
    l830 := line.new(bar_index, open, bar_index + 1, open, color = color.new(#E0E0E0, 45), style = line.style_dotted, extend = extend.right)
    label.new(bar_index, open, "08:30 open", style = label.style_none, textcolor = color.new(#9E9E9E, 0), size = size.tiny)
if newWeek and showOpens and isIntra
    line.delete(lWk)
    lWk := line.new(bar_index, open, bar_index + 1, open, color = color.new(#FFB300, 30), style = line.style_dashed, extend = extend.right)
    label.new(bar_index, open, "Weekly open", style = label.style_none, textcolor = color.new(#FFB300, 0), size = size.tiny)

// Asia / London / New York range boxes
f_sessBox(bool inS, string name, color c) =>
    var box   b  = na
    var float hi = na
    var float lo = na
    if inS
        if not inS[1]
            hi := high
            lo := low
            b := box.new(bar_index, high, bar_index, low, border_color = color.new(c, 45), bgcolor = color.new(c, 93), text = name, text_size = size.tiny, text_color = color.new(c, 10), text_halign = text.align_left, text_valign = text.align_top)
        else
            hi := math.max(hi, high)
            lo := math.min(lo, low)
            box.set_top(b, hi)
            box.set_bottom(b, lo)
            box.set_right(b, bar_index)
    b
bool sessOk = showSessBox and isIntra and chartSecTK <= 3600
f_sessBox(sessOk and inAsia, "Asia", #9E9E9E)
f_sessBox(sessOk and inLondon, "London", #2962FF)
f_sessBox(sessOk and inNYAM, "New York", #089981)

// new day / new week opening gaps
var array<box> gapBoxes = array.new<box>()
bool newBrokerDay = timeframe.change("D")
if showGaps and isIntra and bar_index > 0 and newBrokerDay and math.abs(open - close[1]) >= syminfo.mintick
    box g = box.new(bar_index, math.max(open, close[1]), bar_index + 1, math.min(open, close[1]), border_color = color.new(#00BCD4, 40), bgcolor = color.new(#00BCD4, 85), extend = extend.right, text = newWeek ? "NWOG" : "NDOG", text_size = size.tiny, text_color = color.new(#00BCD4, 0), text_halign = text.align_right)
    gapBoxes.push(g)
    if gapBoxes.size() > 4
        box.delete(gapBoxes.shift())

// displacement candles, Silver Bullet windows, previous month high / low
bool dispBar = not na(atr) and math.abs(close - open) >= dispAtr * atr and (close > open ? close >= high - 0.25 * (high - low) : close <= low + 0.25 * (high - low))
barcolor(showDispBar and dispBar ? (close > open ? #00E676 : #FF1744) : na, title = "Displacement candles")
bool inSB = f_inSess("0300-0400") or f_inSess("1000-1100") or f_inSess("1400-1500")
bgcolor(showSB and inSB and isIntra and chartSecTK <= 900 ? color.new(#FFEB3B, 90) : na, title = "Silver Bullet")
[pmH, pmL] = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead = barmerge.lookahead_on)
var line lPMH = na
var line lPML = na
if showPM and barstate.islast and not na(pmH)
    line.delete(lPMH)
    line.delete(lPML)
    lPMH := line.new(bar_index - 20, pmH, bar_index + 15, pmH, color = color.new(cLiq, 30), style = line.style_dashed)
    lPML := line.new(bar_index - 20, pmL, bar_index + 15, pmL, color = color.new(cLiq, 30), style = line.style_dashed)
    label.new(bar_index + 15, pmH, "PMH", style = label.style_label_left, color = color(na), textcolor = cLiq, size = size.tiny)
    label.new(bar_index + 15, pmL, "PML", style = label.style_label_left, color = color(na), textcolor = cLiq, size = size.tiny)

// ===================================================================== risk guard
// top-down context: completed higher-timeframe candles only (no repaint)
[a1Tr, a1Top, a1Bot, a1SwH, a1SwL, a1BT, a1BB, a1ST, a1SB, a1PH, a1PL] = request.security(syminfo.tickerid, mtfTf1, f_mtf(mtfLen), lookahead = barmerge.lookahead_on)
[a2Tr, a2Top, a2Bot, a2SwH, a2SwL, a2BT, a2BB, a2ST, a2SB, a2PH, a2PL] = request.security(syminfo.tickerid, mtfTf2, f_mtf(mtfLen), lookahead = barmerge.lookahead_on)
[a3Tr, a3Top, a3Bot, a3SwH, a3SwL, a3BT, a3BB, a3ST, a3SB, a3PH, a3PL] = request.security(syminfo.tickerid, mtfTf3, f_mtf(mtfLen), lookahead = barmerge.lookahead_on)
[a4Tr, a4Top, a4Bot, a4SwH, a4SwL, a4BT, a4BB, a4ST, a4SB, a4PH, a4PL] = request.security(syminfo.tickerid, mtfTf4, f_mtf(mtfLen), lookahead = barmerge.lookahead_on)
int chartSec  = chartSecTK
int s1Sec     = timeframe.in_seconds(mtfTf1)
int s2Sec     = timeframe.in_seconds(mtfTf2)
int s3Sec     = timeframe.in_seconds(mtfTf3)
int s4Sec     = timeframe.in_seconds(mtfTf4)
int biasSec   = timeframe.in_seconds(biasTf)
int structSec = timeframe.in_seconds(structTf)

f_tfs(int sec, int chartS, int tr, float top, float bot, float swH, float swL, float bT, float bB, float sT, float sB, float pH) =>
    bool up = sec > chartS
    TFS.new(sec, f_tfLabel(sec), up, up and not na(pH), nz(tr), top, bot, swH, swL, bT, bB, sT, sB)

array<TFS> tfs = array.from(f_tfs(s1Sec, chartSec, a1Tr, a1Top, a1Bot, a1SwH, a1SwL, a1BT, a1BB, a1ST, a1SB, a1PH), f_tfs(s2Sec, chartSec, a2Tr, a2Top, a2Bot, a2SwH, a2SwL, a2BT, a2BB, a2ST, a2SB, a2PH), f_tfs(s3Sec, chartSec, a3Tr, a3Top, a3Bot, a3SwH, a3SwL, a3BT, a3BB, a3ST, a3SB, a3PH), f_tfs(s4Sec, chartSec, a4Tr, a4Top, a4Bot, a4SwH, a4SwL, a4BT, a4BB, a4ST, a4SB, a4PH))

// abnormal volatility: shock candle / gap against the slow ATR *before* this candle
float atrSlow  = ta.atr(regimeLen)
int   chartMin = math.max(1, int(chartSec / 60))
if useGuard and bar_index > 0 and not na(atrSlow[1])
    float refA   = atrSlow[1]
    float rngNow = high - low
    float gapNow = math.abs(open - close[1])
    if rngNow > shockMult * refA or gapNow > shockMult * refA
        gs.shockUntil := bar_index + math.max(1, int(math.ceil(shockCoolMin * 1.0 / chartMin)))
        gs.shockWhy   := (gapNow > shockMult * refA ? "gap of " + str.tostring(gapNow / refA, "#.#") : "candle of " + str.tostring(rngNow / refA, "#.#")) + "x average range"
float regime = atr / atrSlow
float adrD   = request.security(syminfo.tickerid, "D", ta.sma(high - low, adrLen)[1], lookahead = barmerge.lookahead_on)

// time of this candle's close in New York
int    nyDow  = dayofweek(time_close, "America/New_York")
int    nyMin  = hour(time_close, "America/New_York") * 60 + minute(time_close, "America/New_York")
string nyMD   = f_pad2(month(time_close, "America/New_York")) + "-" + f_pad2(dayofmonth(time_close, "America/New_York"))
bool   fxHrs  = mktHours == "Forex / XAUUSD"
bool   isFri  = nyDow == dayofweek.friday
bool   isSat  = nyDow == dayofweek.saturday
bool   isSun  = nyDow == dayofweek.sunday

string whyBreaker = ""
if useGuard
    if gs.halted
        whyBreaker := "breaker: drawdown reached " + str.tostring(maxDDR) + "R - trading halted"
    else if bar_index < gs.pauseUntil
        whyBreaker := "breaker: " + str.tostring(maxConsec) + " losses in a row - pausing " + str.tostring(gs.pauseUntil - bar_index) + " more bars"
    else if maxDayR > 0 and gs.dayR <= -maxDayR
        whyBreaker := "breaker: daily loss " + str.tostring(gs.dayR, "#.#") + "R - done for the day"
    else if maxWeekR > 0 and gs.weekR <= -maxWeekR
        whyBreaker := "breaker: weekly loss " + str.tostring(gs.weekR, "#.#") + "R - done for the week"

string whySession = ""
if useGuard and fxHrs
    if (isFri and nyMin >= 17 * 60) or isSat or (isSun and nyMin < 18 * 60)
        whySession := "session: market closed for the weekend"
    else if str.contains(holidays, nyMD)
        whySession := "session: holiday - thin liquidity"
    else if f_inRange(nyMin, f_hm(rollStartS), f_hm(rollEndS))
        whySession := "session: daily rollover - spreads widen"
    else if isFri and nyMin >= f_hm(friCutS)
        whySession := "session: Friday afternoon - no new trades into the weekend"
    else if isSun and nyMin < f_hm(sunUntilS)
        whySession := "session: Sunday open - waiting for liquidity"

f_evWhy(bool on, int ev, int before, int after) =>
    on and time_close >= ev - before * 60000 and time_close <= ev + after * 60000 ? "news: high-impact event at " + str.format_time(ev, "EEE HH:mm", "America/New_York") + " NY" : ""

string whyEvent    = ""
string whyImminent = ""
string whyStd      = ""
if useGuard and newsOn
    string e1 = f_evWhy(ev1On, ev1, newsBefore, newsAfter)
    string e2 = f_evWhy(ev2On, ev2, newsBefore, newsAfter)
    string e3 = f_evWhy(ev3On, ev3, newsBefore, newsAfter)
    whyEvent := e1 != "" ? e1 : e2 != "" ? e2 : e3
    string i1 = f_evWhy(ev1On, ev1, newsBefore, 0)
    string i2 = f_evWhy(ev2On, ev2, newsBefore, 0)
    string i3 = f_evWhy(ev3On, ev3, newsBefore, 0)
    whyImminent := i1 != "" ? i1 : i2 != "" ? i2 : i3
    if not isSat and not isSun
        for w in str.split(stdWinS, ",")
            string wt = str.trim(w)
            if str.length(wt) >= 5
                int evm = f_hm(wt)
                if nyMin >= evm - stdBefore and nyMin <= evm + stdAfter
                    whyStd := "news: typical US release window " + wt + " NY"
                    break
string whyNews = whyEvent != "" ? whyEvent : whyStd

string whyVol = ""
if useGuard
    if bar_index < gs.shockUntil
        whyVol := "volatility: shock (" + gs.shockWhy + ") - cooling down"
    else if not na(regime) and regime > regimeMax
        whyVol := "volatility: extreme regime (ATR " + str.tostring(regime, "#.#") + "x its average)"
    else if not na(adrD) and adrD > 0 and adrMax > 0 and dH - dL >= adrMax * adrD
        whyVol := "volatility: day already moved " + str.tostring((dH - dL) / adrD, "#.#") + "x its average range"

string preWhy = f_add(f_add(f_add(whyBreaker, whySession), whyNews), whyVol)

// every higher timeframe must allow the trade; the target is capped before HTF obstacles
f_guardCheck(int d, float e, float sl, float tp, array<TFS> tfl, array<Level> lvls, float atrV, string pre, int biasS, int structS) =>
    string blocks  = pre
    string notes   = ""
    float  newTp   = tp
    float  risk    = math.abs(e - sl)
    int    usable  = 0
    int    aligned = 0
    int    ups     = 0
    for tf in tfl
        if tf.up
            ups += 1
        if tf.use and tf.trend != 0
            usable += 1
            if tf.trend == d
                aligned += 1
            else if tf.sec == biasS
                blocks := f_add(blocks, "mtf: " + tf.lbl + " trend is " + (tf.trend == 1 ? "bullish" : "bearish"))
            else if tf.sec == structS
                float pos = f_rangePos(tf, e)
                if na(pos) or (d == 1 ? pos > 0.5 : pos < 0.5)
                    blocks := f_add(blocks, "mtf: " + tf.lbl + " trend is " + (tf.trend == 1 ? "bullish" : "bearish") + " and entry is not in its " + (d == 1 ? "discount" : "premium"))
    if usable > 0
        if aligned < math.min(mtfMinAlign, usable)
            blocks := f_add(blocks, "mtf: only " + str.tostring(aligned) + "/" + str.tostring(usable) + " higher timeframes agree")
    else if ups > 0
        blocks := f_add(blocks, "mtf: higher-timeframe structure not established yet")
    for tf in tfl
        if tf.use
            if tf.sec == biasS or tf.sec == structS
                float pos = f_rangePos(tf, e)
                if not na(pos)
                    if d == 1 and pos > mtfPdExt
                        blocks := f_add(blocks, "mtf: buying at " + str.tostring(pos * 100, "#") + "% of the " + tf.lbl + " range (premium)")
                    else if d == -1 and pos < 1 - mtfPdExt
                        blocks := f_add(blocks, "mtf: selling at " + str.tostring(pos * 100, "#") + "% of the " + tf.lbl + " range (discount)")
            float gTop = d == 1 ? tf.sT : tf.bT
            float gBot = d == 1 ? tf.sB : tf.bB
            if not na(gTop) and not na(gBot)
                if e >= gBot and e <= gTop
                    blocks := f_add(blocks, "mtf: entry inside the " + tf.lbl + (d == 1 ? " bearish" : " bullish") + " FVG")
    if obstacleOn and risk > 0
        float  bestD = na
        float  bestP = na
        string bestN = ""
        if lvls.size() > 0
            for lv in lvls
                bool kindOk = d == 1 ? (lv.kind == "pdh" or lv.kind == "pwh") : (lv.kind == "pdl" or lv.kind == "pwl")
                if lv.side == d and kindOk
                    float dist = (lv.price - e) * d
                    if dist > 0 and (tp - lv.price) * d > 0 and (na(bestD) or dist < bestD)
                        bestD := dist
                        bestP := lv.price
                        bestN := lv.kind == "pdh" ? "previous day high" : lv.kind == "pwh" ? "previous week high" : lv.kind == "pdl" ? "previous day low" : "previous week low"
        for tf in tfl
            if tf.use
                float sw = d == 1 ? tf.swH : tf.swL
                if not na(sw)
                    float dist = (sw - e) * d
                    if dist > 0 and (tp - sw) * d > 0 and (na(bestD) or dist < bestD)
                        bestD := dist
                        bestP := sw
                        bestN := tf.lbl + " swing " + (d == 1 ? "high" : "low")
                float edge = d == 1 ? tf.sB : tf.bT
                if not na(edge)
                    float dist = (edge - e) * d
                    if dist > 0 and (tp - edge) * d > 0 and (na(bestD) or dist < bestD)
                        bestD := dist
                        bestP := edge
                        bestN := tf.lbl + (d == 1 ? " bearish" : " bullish") + " FVG"
        if not na(bestP)
            float nt = bestP - d * obstacleBuf * atrV
            float rr = (nt - e) * d / risk
            if rr >= minRR - 1e-9
                newTp := nt
                notes := "target capped before the " + bestN + " (" + f_px(bestP) + ") at " + str.tostring(rr, "#.##") + "R"
            else
                blocks := f_add(blocks, "obstacle: " + bestN + " at " + f_px(bestP) + " only " + str.tostring(rr, "#.##") + "R away")
    [blocks == "", newTp, blocks, notes]

bool   gOkL   = true
float  gTpL   = sigTPL
string gWhyL  = ""
string gNoteL = ""
if useGuard and armL
    [okG, tpG, whyG, noteG] = f_guardCheck(1, sigEL, sigSLL, sigTPL, tfs, levels, atr, preWhy, biasSec, structSec)
    gOkL   := okG
    gTpL   := tpG
    gWhyL  := whyG
    gNoteL := noteG
bool   gOkS   = true
float  gTpS   = sigTPS
string gWhyS  = ""
string gNoteS = ""
if useGuard and armS
    [okG, tpG, whyG, noteG] = f_guardCheck(-1, sigES, sigSLS, sigTPS, tfs, levels, atr, preWhy, biasSec, structSec)
    gOkS   := okG
    gTpS   := tpG
    gWhyS  := whyG
    gNoteS := noteG
// confirmation checklist: 15 ICT / SMC confirmations behind a setup
f_ck(string acc, bool ok, string lbl) =>
    string ln = (ok ? "✅ " : "⬜ ") + lbl
    acc == "" ? ln : acc + "\n" + ln

f_checks(int d, bool isRev, bool major, bool pdOk, bool confl, bool disp, bool zfvg, float retr, float e) =>
    bool biasOk   = false
    bool structOk = false
    for tf in tfs
        if tf.use and tf.sec == biasSec
            biasOk := tf.trend == d
        if tf.use and tf.sec == structSec
            float pos = f_rangePos(tf, e)
            structOk := tf.trend == d or (not na(pos) and (d == 1 ? pos <= 0.5 : pos >= 0.5))
    bool   ote    = not na(retr) and retr >= 0.62 and retr <= 0.79
    int    smtBar = d == 1 ? smtBullBar : smtBearBar
    bool   smt    = smtOn and not na(smtBar) and bar_index - smtBar <= mssWindow + intLen
    bool   openOk = not na(midOpen) and (d == 1 ? e < midOpen : e > midOpen)
    string side   = d == 1 ? "bullish" : "bearish"
    array<bool>   oks  = array.from(true, htfTrend == d, biasOk, structOk, swgS.trend == d, pdOk, major, disp, zfvg, confl, ote, inKzScore, inSB, smt, openOk)
    array<string> lbls = array.from(isRev ? "Liquidity taken + market structure shift" : "Break of structure with the swing trend", "HTF bias " + side + " (" + f_tfLabel(timeframe.in_seconds(htfTF)) + ")", f_tfLabel(biasSec) + " trend " + side, f_tfLabel(structSec) + " structure " + side + " or pullback", "Swing structure " + side, d == 1 ? "Entry in discount" : "Entry in premium", "Major liquidity swept", "Displacement candle", "Fair value gap entry", "Order block + FVG overlap", "OTE 62-79%" + (na(retr) ? "" : " (" + str.tostring(retr * 100, "#") + "%)"), "Inside a killzone", "Silver Bullet window", "SMT divergence", d == 1 ? "Below the midnight open" : "Above the midnight open")
    int    n   = 0
    string txt = ""
    for i = 0 to oks.size() - 1
        bool ok = oks.get(i)
        n   += ok ? 1 : 0
        txt := f_ck(txt, ok, lbls.get(i))
    [n, txt]

int    confL = 0
string ckL   = ""
string hsL   = ""
if armL
    [nC, tC] = f_checks(1, revPickL, revPickL and revL.major, sigPdL, sigCfL, sigDsL, sigZfL, sigReL, sigEL)
    confL := nC
    ckL   := tC
    hsL   := f_hist(f_hIdx(revPickL, sigScL))
    if minConf > 0 and confL < minConf
        gWhyL := f_add(gWhyL, "confirmations: " + str.tostring(confL) + "/15, minimum " + str.tostring(minConf))
int    confS = 0
string ckS   = ""
string hsS   = ""
if armS
    [nC, tC] = f_checks(-1, revPickS, revPickS and revS.major, sigPdS, sigCfS, sigDsS, sigZfS, sigReS, sigES)
    confS := nC
    ckS   := tC
    hsS   := f_hist(f_hIdx(revPickS, sigScS))
    if minConf > 0 and confS < minConf
        gWhyS := f_add(gWhyS, "confirmations: " + str.tostring(confS) + "/15, minimum " + str.tostring(minConf))

bool  allowL   = armL and gOkL and (minConf == 0 or confL >= minConf)
bool  allowS   = armS and gOkS and (minConf == 0 or confS >= minConf)
float rrL      = armL ? (gTpL - sigEL) / math.abs(sigEL - sigSLL) : na
float rrS      = armS ? (sigES - gTpS) / math.abs(sigES - sigSLS) : na
float tp1L     = armL and tp1On and tp1R < rrL ? sigEL + tp1R * math.abs(sigEL - sigSLL) : na
float tp1S     = armS and tp1On and tp1R < rrS ? sigES - tp1R * math.abs(sigES - sigSLS) : na
float sizeMult = useGuard and not na(regime) and regime > cautionRatio ? 0.5 : 1.0

// guard actions on the tracked trade (before new setups, like the agent)
string gAct    = ""
string gActWhy = ""
if useGuard and not na(cur)
    if cur.status == 0
        string w = whyBreaker != "" ? whyBreaker : whySession != "" ? whySession : whyEvent != "" ? whyEvent : bar_index < gs.shockUntil ? "volatility: shock (" + gs.shockWhy + ")" : ""
        if w != ""
            gAct    := "cancel"
            gActWhy := w
    else
        if fxHrs and wkCloseOn and ((isFri and nyMin >= f_hm(wkCloseS)) or isSat or (isSun and nyMin < 18 * 60))
            gAct    := "close"
            gActWhy := "weekend: flat before the market closes"
        else if whyImminent != "" and newsAction == "Close"
            gAct    := "close"
            gActWhy := whyImminent
        else if whyImminent != "" and newsAction == "Protect" and not cur.beMoved and (close - cur.fillPrice) * cur.dir > 0
            gAct    := "protect"
            gActWhy := whyImminent
        else if structExit and ((cur.dir == 1 and iBear and iBearKind == "CHoCH") or (cur.dir == -1 and iBull and iBullKind == "CHoCH"))
            gAct    := "close"
            gActWhy := "structure: internal CHoCH against the trade"
if gAct == "cancel"
    //@@CANCEL
    if showTrades
        for ln in array.from(cur.lE, cur.lS, cur.lT)
            line.set_x2(ln, bar_index)
            line.set_color(ln, color.new(color.gray, 50))
        if not na(cur.lT1)
            line.set_x2(cur.lT1, bar_index)
            line.set_color(cur.lT1, color.new(color.gray, 50))
        label.new(bar_index, cur.entry, "x", style = label.style_label_left, color = color(na), textcolor = color.gray, size = size.tiny, tooltip = "Order cancelled by the guard: " + gActWhy)
    if alertGuard and readableOn
        alert("🛡 GUARD - " + symTf + "\nPending " + (cur.dir == 1 ? "buy" : "sell") + " limit " + f_px(cur.entry) + " CANCELLED\n" + gActWhy, alert.freq_once_per_bar_close)
    cur := na
else if gAct == "protect"
    cur.slCur   := cur.fillPrice
    cur.beMoved := true
    //@@BE
    if alertGuard and readableOn
        alert("🛡 GUARD - " + symTf + "\nStop moved to entry " + f_px(cur.fillPrice) + " (" + (cur.dir == 1 ? "long" : "short") + ")\n" + gActWhy, alert.freq_once_per_bar_close)
else if gAct == "close"
    //@@GUARDCLOSE
    float gRest = (close - cur.fillPrice) * cur.dir / cur.risk
    float gxR   = cur.partFrac > 0 ? cur.partFrac * (cur.partPrice - cur.fillPrice) * cur.dir / cur.risk + (1 - cur.partFrac) * gRest : gRest
    stats.record(gxR)
    gs.onClosed(gxR)
    f_histAdd(cur.hIdx, gxR)
    if showTrades
        box.set_right(cur.bT, bar_index)
        box.set_right(cur.bS, bar_index)
        if not na(cur.lT1)
            line.set_x2(cur.lT1, bar_index)
        label.new(bar_index, close, (gxR >= 0 ? "+" : "") + str.tostring(gxR, "#.##") + "R", style = label.style_label_left, color = color(na), textcolor = gxR > 0 ? C_BULL : gxR < 0 ? C_BEAR : color.gray, size = size.small, tooltip = "Closed by the guard: " + gActWhy)
    if alertGuard and readableOn
        alert("🛡 GUARD - " + symTf + "\n" + (cur.dir == 1 ? "Long" : "Short") + " CLOSED at " + f_px(close) + " | result " + (gxR >= 0 ? "+" : "") + str.tostring(gxR, "#.##") + "R\n" + gActWhy, alert.freq_once_per_bar_close)
    exitPrice  := close
    exitR      := gxR
    exitReason := "guard"
    evExit     := true
    cur := na

f_tooltip(int d, bool isRev, Rev st, float e, float sl, float tp1, float tp, float rr, int score, string tpKind, int nConf, string checks, string hist) =>
    string t = (isRev ? "Reversal" : "Continuation") + " | score " + str.tostring(score) + "/10 (" + f_grade(score) + ") | " + str.tostring(nConf) + "/15 confirmations\n"
    t += "Entry (limit) " + f_px(e) + "\nStop loss " + f_px(sl) + "\n"
    if not na(tp1)
        t += "TP1 " + f_px(tp1) + " (" + str.tostring(tp1R) + "R: close " + str.tostring(tp1Pct) + "%, stop to entry)\n"
    t += "Target " + f_px(tp) + " (" + str.tostring(rr, "#.##") + "R -> " + tpKind + ")\n"
    if isRev
        t += "Took " + (d == 1 ? "sell" : "buy") + "-side liquidity at " + f_px(st.ext) + ", MSS (" + st.mssKind + ") through " + f_px(st.mssPrice) + "\n"
    t + checks + "\n" + hist

var array<box> oteBoxes = array.new<box>()
f_oteBox(int d, float far, float origin, int originBar) =>
    if showOTE and not na(far) and not na(origin) and not na(originBar) and (far - origin) * d > 0
        float rng = math.abs(far - origin)
        float a   = far - d * 0.62 * rng
        float b   = far - d * 0.79 * rng
        oteBoxes.push(box.new(originBar, math.max(a, b), bar_index + entryExpiry, math.min(a, b), border_color = color.new(#00BCD4, 50), bgcolor = color.new(#00BCD4, 90), text = "OTE 62-79%", text_size = size.tiny, text_color = color.new(#00BCD4, 10), text_halign = text.align_left, text_valign = text.align_bottom))
        if oteBoxes.size() > 6
            box.delete(oteBoxes.shift())

if allowL
    label.new(bar_index, low, "BUY " + f_grade(sigScL) + "\n" + str.tostring(confL) + "/15", style = label.style_label_up, color = C_BULL, textcolor = color.white, size = size.small, tooltip = f_tooltip(1, revPickL, revL, sigEL, sigSLL, tp1L, gTpL, rrL, sigScL, sigTkL, confL, ckL, hsL) + (gNoteL != "" ? "\n" + gNoteL : "") + (sizeMult < 1 ? "\nElevated volatility: half size" : ""))
    f_oteBox(1, sigFarL, sigOrL, sigObL)
else if armL and showBlocked
    label.new(bar_index, low, "BUY?", style = label.style_label_up, color = color.new(color.gray, 55), textcolor = color.white, size = size.tiny, tooltip = "Setup blocked:\n" + gWhyL + "\n\n" + ckL)
if allowS
    label.new(bar_index, high, "SELL " + f_grade(sigScS) + "\n" + str.tostring(confS) + "/15", style = label.style_label_down, color = C_BEAR, textcolor = color.white, size = size.small, tooltip = f_tooltip(-1, revPickS, revS, sigES, sigSLS, tp1S, gTpS, rrS, sigScS, sigTkS, confS, ckS, hsS) + (gNoteS != "" ? "\n" + gNoteS : "") + (sizeMult < 1 ? "\nElevated volatility: half size" : ""))
    f_oteBox(-1, sigFarS, sigOrS, sigObS)
else if armS and showBlocked
    label.new(bar_index, high, "SELL?", style = label.style_label_down, color = color.new(color.gray, 55), textcolor = color.white, size = size.tiny, tooltip = "Setup blocked:\n" + gWhyS + "\n\n" + ckS)

// the tracked trade: highest score wins, a fresher setup replaces a pending order,
// setups are ignored while a position is open (same as the agent's backtester)
int pick = allowL and allowS ? (sigScL >= sigScS ? 1 : -1) : allowL ? 1 : allowS ? -1 : 0
bool placed   = false
bool canPlace = na(cur)
if not na(cur)
    canPlace := cur.status == 0
if pick != 0 and canPlace
    if not na(cur)
        //@@CANCEL
        if showTrades
            for ln in array.from(cur.lE, cur.lS, cur.lT)
                line.set_x2(ln, bar_index)
                line.set_color(ln, color.new(color.gray, 50))
            if not na(cur.lT1)
                line.set_x2(cur.lT1, bar_index)
                line.set_color(cur.lT1, color.new(color.gray, 50))
    float  e     = pick == 1 ? sigEL : sigES
    float  sl    = pick == 1 ? sigSLL : sigSLS
    float  tp    = pick == 1 ? gTpL : gTpS
    bool   isRev = pick == 1 ? revPickL : revPickS
    int    sc    = pick == 1 ? sigScL : sigScS
    cur := Trade.new(pick, isRev ? "reversal" : "continuation", e, sl, sl, tp, math.abs(e - sl), bar_index)
    cur.tp1   := pick == 1 ? tp1L : tp1S
    cur.grade := f_grade(sc)
    cur.hIdx  := f_hIdx(isRev, sc)
    placed := true
    //@@ARM
    if showTrades
        cur.lE := line.new(bar_index, e, bar_index + entryExpiry, e, color = color.new(color.gray, 0), style = line.style_dashed, width = 1)
        cur.lS := line.new(bar_index, sl, bar_index + entryExpiry, sl, color = color.new(C_BEAR, 20), style = line.style_dashed, width = 1)
        cur.lT := line.new(bar_index, tp, bar_index + entryExpiry, tp, color = color.new(C_BULL, 20), style = line.style_dashed, width = 1)
        if not na(cur.tp1)
            cur.lT1 := line.new(bar_index, cur.tp1, bar_index + entryExpiry, cur.tp1, color = color.new(#FFB300, 20), style = line.style_dashed, width = 1)

// price tags for the tracked trade (latest bar only)
var array<label> tradeTags = array.new<label>()
if barstate.islast
    for lb in tradeTags
        label.delete(lb)
    tradeTags.clear()
    if showTrades and not na(cur)
        int   tx = bar_index + 3
        float ep = cur.status == 0 ? cur.entry : cur.fillPrice
        tradeTags.push(label.new(tx, ep, (cur.status == 0 ? "Entry (limit) " : "Entry ") + f_px(ep), style = label.style_label_left, color = color.new(color.gray, 25), textcolor = color.white, size = size.tiny))
        tradeTags.push(label.new(tx, cur.slCur, (cur.beMoved ? "SL at entry " : "SL ") + f_px(cur.slCur), style = label.style_label_left, color = color.new(C_BEAR, 25), textcolor = color.white, size = size.tiny))
        if not na(cur.tp1) and not cur.tp1Done
            tradeTags.push(label.new(tx, cur.tp1, "TP1 " + f_px(cur.tp1) + " (" + str.tostring(tp1Pct) + "%)", style = label.style_label_left, color = color.new(#FFB300, 15), textcolor = color.black, size = size.tiny))
        tradeTags.push(label.new(tx, cur.tp, "TP " + f_px(cur.tp), style = label.style_label_left, color = color.new(C_BULL, 25), textcolor = color.white, size = size.tiny))

var string lastSetup = "-"
var color  lastCol   = color.gray
if allowL or allowS
    int ld = pick != 0 ? pick : allowL ? 1 : -1
    lastSetup := (ld == 1 ? "BUY " + f_grade(sigScL) + " | " + str.tostring(confL) : "SELL " + f_grade(sigScS) + " | " + str.tostring(confS)) + "/15 | " + str.format_time(time_close, "dd MMM HH:mm", "America/New_York")
    lastCol   := ld == 1 ? C_BULL : C_BEAR

// ------------------------------------------------------------------ premium / discount
var box  pdPrem = na
var box  pdDisc = na
var line pdEq   = na
if showPD and barstate.islast and not na(eq)
    box.delete(pdPrem)
    box.delete(pdDisc)
    line.delete(pdEq)
    int   left = math.min(swgS.trailTopBar, swgS.trailBotBar)
    float top  = swgS.trailTop
    float bot  = swgS.trailBot
    pdPrem := box.new(left, top, bar_index + 10, 0.95 * top + 0.05 * bot, border_color = color(na), bgcolor = color.new(C_BEAR, 88), text = "Premium", text_size = size.tiny, text_color = color.new(C_BEAR, 30), text_halign = text.align_right)
    pdDisc := box.new(left, 0.05 * top + 0.95 * bot, bar_index + 10, bot, border_color = color(na), bgcolor = color.new(C_BULL, 88), text = "Discount", text_size = size.tiny, text_color = color.new(C_BULL, 30), text_halign = text.align_right)
    pdEq   := line.new(left, eq, bar_index + 10, eq, color = color.new(color.gray, 30), style = line.style_dotted)

if barstate.islast and levels.size() > 0
    for lv in levels
        if not na(lv.lb)
            label.set_x(lv.lb, bar_index + 2)

// ------------------------------------------------------------------ killzones
bool kzVisible = showKZ and timeframe.isintraday and timeframe.in_seconds() <= 3600
color kzCol = not kzVisible ? na : inLondon ? color.new(#2962FF, 93) : inNYAM ? color.new(#089981, 93) : inNYPM ? color.new(#FF9800, 94) : inLC ? color.new(#9C27B0, 95) : inAsia ? color.new(#787B86, 95) : na
bgcolor(kzCol, title = "Killzones")

// ------------------------------------------------------------------ dashboard
f_pos(string p) =>
    switch p
        "Top right"    => position.top_right
        "Bottom right" => position.bottom_right
        "Top left"     => position.top_left
        => position.bottom_left

f_row(table t, int r, string a, string b, color c) =>
    table.cell(t, 0, r, a, text_color = color.new(color.gray, 10), text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, b, text_color = c, text_size = size.small, text_halign = text.align_right)

f_setupTxt(Rev st, int d) =>
    st.stage == 2 ? "MSS confirmed" : st.stage == 1 ? (d == 1 ? "SSL taken" : "BSL taken") : "waiting"

var table dash = table.new(f_pos(dashPos), 2, 24, bgcolor = color.new(#131722, 15), frame_color = color.new(color.gray, 60), frame_width = 1, border_color = color.new(color.gray, 85), border_width = 1)
if showDash and barstate.islast
    color tc = color.new(color.white, 10)
    f_row(dash, 0, "SMC ICT Pro", "min score " + str.tostring(minScore) + (useGuard ? " | guard ON" : " | guard OFF"), tc)
    int r = 1
    for tf in tfs
        if tf.up
            float pos = f_rangePos(tf, close)
            string posTxt = na(pos) ? "" : " | " + str.tostring(math.max(0, math.min(100, pos * 100)), "#") + "%"
            f_row(dash, r, tf.lbl + (tf.sec == biasSec ? " (bias)" : tf.sec == structSec ? " (structure)" : ""), (tf.use ? f_trendTxt(tf.trend) : "loading") + posTxt, tf.trend == 1 ? C_BULL : tf.trend == -1 ? C_BEAR : tc)
            r += 1
    f_row(dash, r, "Swing / internal", f_trendTxt(swgS.trend) + " / " + f_trendTxt(intS.trend), swgS.trend == 1 ? C_BULL : swgS.trend == -1 ? C_BEAR : tc)
    string zoneTxt = "-"
    if not na(eq) and swgS.trailTop > swgS.trailBot
        float pct = (close - swgS.trailBot) / (swgS.trailTop - swgS.trailBot) * 100
        zoneTxt := (close > eq ? "Premium " : "Discount ") + str.tostring(pct, "#") + "%"
    f_row(dash, r + 1, "Price in range", zoneTxt, close > nz(eq, close) ? C_BEAR : C_BULL)
    string kzTxt = (inLondon ? "London" : inNYAM ? "New York AM" : inLC ? "London close" : inNYPM ? "New York PM" : inAsia ? "Asia" : "-") + (inSB ? " | Silver Bullet" : "")
    f_row(dash, r + 2, "Killzone", kzTxt, inKzScore ? C_BULL : tc)
    string guardTxt = not useGuard ? "off" : preWhy == "" ? "clear" : array.get(str.split(preWhy, "\n"), 0)
    f_row(dash, r + 3, "Guard", guardTxt, not useGuard ? tc : preWhy == "" ? C_BULL : #FF9800)
    string volTxt = na(regime) ? "-" : str.tostring(regime, "#.##") + "x ATR" + (not na(adrD) and adrD > 0 ? " | day " + str.tostring((dH - dL) / adrD, "#.#") + "x ADR" : "")
    f_row(dash, r + 4, "Volatility", volTxt, not na(regime) and regime > cautionRatio ? #FF9800 : tc)
    f_row(dash, r + 5, "Long setup", f_setupTxt(revL, 1), revL.stage > 0 ? C_BULL : tc)
    f_row(dash, r + 6, "Short setup", f_setupTxt(revS, -1), revS.stage > 0 ? C_BEAR : tc)
    string tradeTxt = "flat"
    color  tradeCol = tc
    if not na(cur)
        tradeTxt := (cur.dir == 1 ? "LONG " : "SHORT ") + (cur.status == 0 ? "limit @ " : "open @ ") + f_px(cur.status == 0 ? cur.entry : cur.fillPrice)
        tradeCol := cur.dir == 1 ? C_BULL : C_BEAR
    f_row(dash, r + 7, "Trade", tradeTxt, tradeCol)
    if not na(cur)
        f_row(dash, r + 8, "SL / TP1 / TP", f_px(cur.slCur) + " / " + (na(cur.tp1) ? "-" : cur.tp1Done ? "hit" : f_px(cur.tp1)) + " / " + f_px(cur.tp), tc)
    else
        f_row(dash, r + 8, "SL / TP1 / TP", "-", tc)
    float wr = stats.trades > 0 ? stats.wins * 100.0 / stats.trades : 0.0
    float pf = stats.grossL > 0 ? stats.grossW / stats.grossL : na
    f_row(dash, r + 9, "Trades / win rate", str.tostring(stats.trades) + " / " + str.tostring(wr, "#") + "%", tc)
    f_row(dash, r + 10, "Total R / PF", (stats.sumR >= 0 ? "+" : "") + str.tostring(stats.sumR, "#.#") + "R / " + (na(pf) ? "-" : str.tostring(pf, "#.##")), stats.sumR >= 0 ? C_BULL : C_BEAR)
    f_row(dash, r + 11, "Today / week / DD", str.tostring(gs.dayR, "#.#") + "R / " + str.tostring(gs.weekR, "#.#") + "R / " + str.tostring(gs.peakR - gs.cumR, "#.#") + "R", gs.halted ? C_BEAR : tc)
    f_row(dash, r + 12, "Avg win / avg loss", (stats.wins > 0 ? "+" + str.tostring(stats.grossW / stats.wins, "#.##") : "-") + "R / " + (stats.losses > 0 ? "-" + str.tostring(stats.grossL / stats.losses, "#.##") : "-") + "R", tc)
    string gradeTxt = ""
    for g = 0 to 2
        int gn = hN.get(g) + hN.get(g + 3)
        string gl = g == 0 ? "A+ " : g == 1 ? "A " : "B/C "
        gradeTxt += (g > 0 ? " | " : "") + gl + (gn > 0 ? str.tostring((hW.get(g) + hW.get(g + 3)) * 100.0 / gn, "#") + "% (" + str.tostring(gn) + ")" : "-")
    f_row(dash, r + 13, "Win rate by grade", gradeTxt, tc)
    f_row(dash, r + 14, "Last setup", lastSetup, lastCol)

// ------------------------------------------------------------------ alerts
//@@ALERTCONDITIONS_BEGIN
alertcondition(allowL, "Buy setup armed", "SMC ICT Pro: BUY limit armed on {{ticker}} ({{interval}}) - see chart for entry / stop / target")
alertcondition(allowS, "Sell setup armed", "SMC ICT Pro: SELL limit armed on {{ticker}} ({{interval}}) - see chart for entry / stop / target")
alertcondition(evFill and evDir == 1, "Long filled", "SMC ICT Pro: long entry filled on {{ticker}} ({{interval}})")
alertcondition(evFill and evDir == -1, "Short filled", "SMC ICT Pro: short entry filled on {{ticker}} ({{interval}})")
alertcondition(evTp1, "TP1 hit", "SMC ICT Pro: TP1 hit on {{ticker}} ({{interval}}) - stop moved to entry")
alertcondition(evExit, "Trade closed", "SMC ICT Pro: tracked trade closed on {{ticker}} ({{interval}})")
alertcondition((formingL and revL.major) or (formingS and revS.major), "Setup forming", "SMC ICT Pro: liquidity taken + market structure shift on {{ticker}} ({{interval}}) - setup forming")
alertcondition(sBull or sBear, "Swing BOS / CHoCH", "SMC ICT Pro: swing structure break on {{ticker}} ({{interval}})")
alertcondition(iBull and iBullKind == "CHoCH" or iBear and iBearKind == "CHoCH", "Internal CHoCH", "SMC ICT Pro: internal CHoCH on {{ticker}} ({{interval}})")
alertcondition((sslTaken and sslMajor) or (bslTaken and bslMajor), "Major liquidity swept", "SMC ICT Pro: major liquidity swept on {{ticker}} ({{interval}})")
alertcondition((armL and not allowL) or (armS and not allowS), "Setup blocked by guard", "SMC ICT Pro: a setup on {{ticker}} ({{interval}}) was blocked by the risk guard")
alertcondition(gAct == "close" or gAct == "cancel", "Guard acted on trade", "SMC ICT Pro: the risk guard closed / cancelled the tracked trade on {{ticker}} ({{interval}})")
//@@ALERTCONDITIONS_END

f_setupMsg(int d, bool isRev, float e, float sl, float tp1, float tp, float rr, int score, int nConf, string checks, string hist, string note, bool tracked) =>
    string m = (d == 1 ? "🟢 BUY LIMIT " : "🔴 SELL LIMIT ") + symTf + "\n" + (isRev ? "Reversal" : "Continuation") + " setup, grade " + f_grade(score) + " (" + str.tostring(score) + "/10), " + str.tostring(nConf) + "/15 confirmations\n"
    m += "Entry " + f_px(e) + "\nSL " + f_px(sl) + " (risk " + f_px(math.abs(e - sl)) + ")\n"
    if not na(tp1)
        m += "TP1 " + f_px(tp1) + " (" + str.tostring(tp1R) + "R: close " + str.tostring(tp1Pct) + "%, move SL to entry)\n"
    m += "TP " + f_px(tp) + " (" + str.tostring(rr, "#.##") + "R)\n"
    m += "Valid for " + str.tostring(entryExpiry) + " bars" + (sizeMult < 1 ? " | HALF SIZE: volatile market" : "") + "\n"
    m += checks + "\n" + hist
    if note != ""
        m += "\n" + note
    if not tracked
        m += "\n(not tracked: the chart tracker already holds a trade or took the opposite setup)"
    m

if alertArmed and readableOn and allowL
    alert(f_setupMsg(1, revPickL, sigEL, sigSLL, tp1L, gTpL, rrL, sigScL, confL, ckL, hsL, gNoteL, placed and pick == 1), alert.freq_once_per_bar_close)
if alertArmed and readableOn and allowS
    alert(f_setupMsg(-1, revPickS, sigES, sigSLS, tp1S, gTpS, rrS, sigScS, confS, ckS, hsS, gNoteS, placed and pick == -1), alert.freq_once_per_bar_close)
if alertForming and readableOn and formingL and revL.major and not armL
    alert("⏳ SETUP FORMING - " + symTf + " (long)\nSell-side liquidity taken at " + f_px(revL.ext) + "\nMarket structure shift (" + revL.mssKind + ") through " + f_px(revL.mssPrice) + "\nWaiting for the entry zone (FVG / order block)" + (preWhy != "" ? "\nGuard: " + array.get(str.split(preWhy, "\n"), 0) : ""), alert.freq_once_per_bar_close)
if alertForming and readableOn and formingS and revS.major and not armS
    alert("⏳ SETUP FORMING - " + symTf + " (short)\nBuy-side liquidity taken at " + f_px(revS.ext) + "\nMarket structure shift (" + revS.mssKind + ") through " + f_px(revS.mssPrice) + "\nWaiting for the entry zone (FVG / order block)" + (preWhy != "" ? "\nGuard: " + array.get(str.split(preWhy, "\n"), 0) : ""), alert.freq_once_per_bar_close)

if jsonOn and placed
    int    d     = pick
    bool   isRev = d == 1 ? revPickL : revPickS
    float  e     = d == 1 ? sigEL : sigES
    float  sl    = d == 1 ? sigSLL : sigSLS
    float  tp    = d == 1 ? gTpL : gTpS
    float  rr    = d == 1 ? rrL : rrS
    float  ra    = d == 1 ? sigRAL : sigRAS
    int    sc    = d == 1 ? sigScL : sigScS
    bool   pdOk  = d == 1 ? sigPdL : sigPdS
    bool   confl = d == 1 ? sigCfL : sigCfS
    bool   disp  = d == 1 ? sigDsL : sigDsS
    bool   zf    = d == 1 ? sigZfL : sigZfS
    bool   maj   = isRev and (d == 1 ? revL.major : revS.major)
    float  retr  = d == 1 ? sigReL : sigReS
    bool   ote   = not na(retr) and retr >= 0.62 and retr <= 0.79
    string feats = "{\"htf_aligned\":" + (htfTrend == d ? "1" : "0") + ",\"htf_opposed\":" + (htfTrend == -d ? "1" : "0") + ",\"swing_aligned\":" + (swgS.trend == d ? "1" : "0") + ",\"killzone\":" + (inKzScore ? "1" : "0") + ",\"pd_ok\":" + (pdOk ? "1" : "0") + ",\"major_sweep\":" + (maj ? "1" : "0") + ",\"zone_confluence\":" + (confl ? "1" : "0") + ",\"displacement\":" + (disp ? "1" : "0") + ",\"model_reversal\":" + (isRev ? "1" : "0") + ",\"zone_fvg\":" + (zf ? "1" : "0") + ",\"ote\":" + (ote ? "1" : "0") + ",\"is_long\":" + (d == 1 ? "1" : "0") + ",\"rr\":" + str.tostring(rr, "#.####") + ",\"risk_atr\":" + str.tostring(ra, "#.####") + "}"
    string js = "{\"passphrase\":\"" + passphrase + "\",\"event\":\"setup\",\"ticker\":\"" + syminfo.ticker + "\",\"exchange\":\"" + syminfo.prefix + "\",\"tf\":\"" + timeframe.period + "\",\"side\":\"" + (d == 1 ? "long" : "short") + "\",\"model\":\"" + (isRev ? "reversal" : "continuation") + "\",\"entry\":" + f_num(e) + ",\"sl\":" + f_num(sl) + ",\"tp\":" + f_num(tp) + (na(cur.tp1) ? "" : ",\"tp1\":" + f_num(cur.tp1)) + ",\"confirmations\":" + str.tostring(d == 1 ? confL : confS) + ",\"rr\":" + str.tostring(rr, "#.###") + ",\"score\":" + str.tostring(sc) + ",\"grade\":\"" + f_grade(sc) + "\",\"expiry_bars\":" + str.tostring(entryExpiry) + ",\"features\":" + feats + ",\"time\":" + str.tostring(time) + "}"
    alert(js, alert.freq_once_per_bar_close)
